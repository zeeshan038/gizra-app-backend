{
  "paths": {
    "/delivery-man/login": {
      "post": {
        "summary": "Login (driver app)",
        "description": "Phone + password. Driver must be **approved** (`application_status=approved`, `status=true`). Returns JWT for all protected `/delivery-man/*` routes and FCM **topic** for zone/vehicle pushes.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/DeliveryManLoginBody" },
              "example": {
                "phone": "+972501234567",
                "password": "Secret123!",
                "remember_me": true
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login success",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DeliveryManLoginResponse" }
              }
            }
          },
          "401": {
            "description": "Invalid credentials, pending approval, or suspended account",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiError" },
                "examples": {
                  "credentials": {
                    "value": { "status": false, "msg": "Credential do not match, please try again." }
                  },
                  "pending": {
                    "value": { "status": false, "msg": "Your application is not approved yet" }
                  }
                }
              }
            }
          }
        },
        "tags": ["Delivery Man Auth"]
      }
    },
    "/delivery-man/register": {
      "post": {
        "summary": "Register delivery man (driver app)",
        "description": "Figma 2-step registration. **Media:** `POST /storage/registration-init` `{ \"role\": \"deliveryman\" }` → `POST /upload` (category `profile` / `identity`) → pass `cloudflare_id` + R2 paths. Requires **`delivery_type` or `earning`**. Admin approval (`npm run approve-riders` or admin panel) before login.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/DeliveryManRegisterBody" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Application submitted",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PartnerApplicationResponse" }
              }
            }
          },
          "400": {
            "description": "Validation error or duplicate phone/email",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiError" }
              }
            }
          }
        },
        "tags": ["Delivery Man Auth"]
      }
    },
    "/delivery-man/password/forgot": {
      "post": {
        "summary": "Forgot password — send OTP",
        "description": "Figma reset flow (phone only). Sends **4-digit OTP** via SMS; email OTP if driver has email. Dev/test OTP often **`1234`**. Resend cooldown in `data.resend_after_seconds`.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/DeliveryManForgotPasswordBody" },
              "example": { "phone": "+972501234567" }
            }
          }
        },
        "responses": {
          "200": { "description": "OTP sent (masked phone in response)" },
          "404": { "description": "Phone not registered" },
          "405": { "description": "Resend cooldown or SMS failure" }
        },
        "tags": ["Delivery Man Auth"]
      }
    },
    "/delivery-man/password/verify-otp": {
      "post": {
        "summary": "Verify forgot-password OTP",
        "description": "OTP screen before create-new-password.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/DeliveryManPasswordOtpBody" },
              "example": { "phone": "+972501234567", "otp": "1234" }
            }
          }
        },
        "responses": {
          "200": { "description": "OTP valid" },
          "400": { "description": "Invalid OTP" },
          "404": { "description": "Phone not found" }
        },
        "tags": ["Delivery Man Auth"]
      }
    },
    "/delivery-man/password/reset": {
      "put": {
        "summary": "Reset password with OTP",
        "description": "Create new password + confirm. Clears stored auth token (re-login required).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/DeliveryManPasswordResetBody" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Password updated",
            "content": {
              "application/json": {
                "example": { "status": true, "msg": "Password changed successfully" }
              }
            }
          },
          "400": { "description": "Invalid OTP or validation error" }
        },
        "tags": ["Delivery Man Auth"]
      }
    },
    "/delivery-man/password/change": {
      "put": {
        "summary": "Change password (logged in)",
        "description": "Profile → Change Password. Bearer from POST /delivery-man/login.",
        "parameters": [{ "$ref": "#/components/parameters/DeliveryManAuthorizationHeader" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/DeliveryManChangePasswordBody" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Password updated",
            "content": {
              "application/json": {
                "example": { "status": true, "msg": "Password successfully updated" }
              }
            }
          },
          "403": {
            "description": "Wrong current password",
            "content": {
              "application/json": {
                "example": { "status": false, "msg": "Current password is incorrect" }
              }
            }
          }
        },
        "tags": ["Delivery Man Auth"]
      }
    },
    "/delivery-man/earnings": {
      "get": {
        "summary": "Earnings summary + history",
        "description": "Wallet totals (PHP profile), period earnings (today / week / month / lifetime from `order_transactions`), and paginated **history** rows with full **order** + line **items**. Uses transactions when present; otherwise falls back to **delivered** orders. Search by order id.",
        "parameters": [
          { "$ref": "#/components/parameters/DeliveryManAuthorizationHeader" },
          {
            "name": "limit",
            "in": "query",
            "schema": { "type": "integer", "default": 15, "minimum": 1, "maximum": 50 }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "1-based page",
            "schema": { "type": "integer", "default": 1 }
          },
          {
            "name": "page",
            "in": "query",
            "schema": { "type": "integer", "minimum": 1 }
          },
          {
            "name": "search",
            "in": "query",
            "schema": { "type": "string" },
            "description": "Filter by order id"
          },
          {
            "name": "summary_only",
            "in": "query",
            "schema": { "type": "boolean" },
            "description": "If true, returns only wallet + period summary"
          }
        ],
        "responses": {
          "200": {
            "description": "Earnings payload",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DeliveryManEarningsResponse" }
              }
            }
          },
          "401": { "description": "Unauthorized" }
        },
        "tags": ["Delivery Man Earnings"]
      }
    },
    "/delivery-man/home": {
      "get": {
        "summary": "Home dashboard stats",
        "description": "Figma home cards: **Today** / **This Week** / **This Month** order counts (by `accepted` time) and **Today's Earning** (delivery fee + tips from `order_transactions`). Bearer from login.",
        "parameters": [{ "$ref": "#/components/parameters/DeliveryManAuthorizationHeader" }],
        "responses": {
          "200": {
            "description": "Dashboard stats",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DeliveryManHomeResponse" },
                "example": {
                  "status": true,
                  "msg": "Success",
                  "data": {
                    "todays_order_count": 2,
                    "this_week_order_count": 12,
                    "this_month_order_count": 33,
                    "todays_earning": 522
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" }
        },
        "tags": ["Delivery Man Home"]
      }
    },
    "/delivery-man/whoami": {
      "get": {
        "summary": "Current driver account",
        "description": "Returns delivery man profile fields (password/auth_token stripped). Same identity as JWT.",
        "parameters": [{ "$ref": "#/components/parameters/DeliveryManAuthorizationHeader" }],
        "responses": {
          "200": {
            "description": "Driver profile",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DeliveryManWhoamiResponse" }
              }
            }
          },
          "401": { "description": "Missing or invalid Bearer token" },
          "404": { "description": "Driver not found" }
        },
        "tags": ["Delivery Man Profile"]
      }
    },
    "/delivery-man/profile": {
      "get": {
        "summary": "Get profile",
        "description": "Delivery man row without password. Prefer **GET /delivery-man/whoami** for app session; this endpoint also accepts legacy `dm_id` query when testing without JWT.",
        "parameters": [
          { "$ref": "#/components/parameters/DeliveryManAuthorizationHeader" },
          {
            "name": "dm_id",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "Legacy/debug only — JWT `id` is used when Bearer is present"
          }
        ],
        "responses": {
          "200": {
            "description": "Profile",
            "content": {
              "application/json": {
                "example": { "status": true, "data": { "id": "4", "f_name": "Ahmed", "zone_id": "2", "active": true } }
              }
            }
          }
        },
        "tags": ["Delivery Man Profile"]
      }
    },
    "/delivery-man/profile/status": {
      "put": {
        "summary": "Toggle online / offline",
        "description": "Flips `active` boolean (available for new order requests). Identity from Bearer JWT only.",
        "parameters": [{ "$ref": "#/components/parameters/DeliveryManAuthorizationHeader" }],
        "requestBody": false,
        "responses": {
          "200": {
            "description": "Status toggled",
            "content": {
              "application/json": {
                "example": { "status": true, "msg": "Status changed to active" }
              }
            }
          }
        },
        "tags": ["Delivery Man Profile"]
      }
    },
    "/delivery-man/orders/history": {
      "get": {
        "summary": "My Orders (past deliveries)",
        "description": "Figma **My Orders** tab: completed/canceled/refunded/failed orders assigned to this driver. Paginated; optional search by order id or restaurant name.",
        "parameters": [
          { "$ref": "#/components/parameters/DeliveryManAuthorizationHeader" },
          {
            "name": "limit",
            "in": "query",
            "schema": { "type": "integer", "default": 10, "minimum": 1, "maximum": 50 }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "1-based page number (legacy PHP name; same as `page`)",
            "schema": { "type": "integer", "default": 1, "minimum": 1 }
          },
          {
            "name": "page",
            "in": "query",
            "schema": { "type": "integer", "minimum": 1 }
          },
          {
            "name": "search",
            "in": "query",
            "schema": { "type": "string" },
            "description": "Order id or restaurant name"
          }
        ],
        "responses": {
          "200": {
            "description": "Order history list",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DeliveryManMyOrdersResponse" }
              }
            }
          },
          "401": { "description": "Unauthorized" }
        },
        "tags": ["Delivery Man Orders"]
      }
    },
    "/delivery-man/orders/active": {
      "get": {
        "summary": "Active assigned orders",
        "description": "Orders currently assigned to this driver (home / My Orders). Statuses include accepted, confirmed, processing, handover, picked_up, etc.",
        "parameters": [{ "$ref": "#/components/parameters/DeliveryManAuthorizationHeader" }],
        "responses": {
          "200": {
            "description": "Order list",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DeliveryManOrderListResponse" }
              }
            }
          },
          "401": { "description": "Unauthorized" }
        },
        "tags": ["Delivery Man Orders"]
      }
    },
    "/delivery-man/orders/latest": {
      "get": {
        "summary": "Order request pool (unassigned)",
        "description": "Poll for new delivery jobs in the driver's **zone** (restaurants with commission / eligible subscription, not self-delivery). Typically shows orders after restaurant confirms (`confirmed` / `processing` / `handover`) when `order_confirmation_model=restaurant`. COD `pending` orders appear only when confirmation model is `deliveryman`. Filters: schedule window, vehicle, digital pending payment.",
        "parameters": [{ "$ref": "#/components/parameters/DeliveryManAuthorizationHeader" }],
        "responses": {
          "200": {
            "description": "Unassigned orders in zone",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DeliveryManOrderListResponse" }
              }
            }
          },
          "401": { "description": "Unauthorized" },
          "404": { "description": "Driver not found" }
        },
        "tags": ["Delivery Man Orders"]
      }
    },
    "/delivery-man/orders/{id}/accept": {
      "put": {
        "summary": "Accept order from pool",
        "description": "Assigns order to driver, increments `current_orders`, emits realtime status. Fails if already taken, outside zone, or max concurrent/cash limits.",
        "parameters": [
          { "$ref": "#/components/parameters/DeliveryManAuthorizationHeader" },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "Order id from GET /delivery-man/orders/latest"
          }
        ],
        "responses": {
          "200": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "example": {
                  "status": true,
                  "msg": "Order accepted successfully",
                  "data": { "id": "42", "order_status": "accepted" }
                }
              }
            }
          },
          "403": { "description": "Order outside delivery area" },
          "404": { "description": "Order not found or already assigned" },
          "405": { "description": "Max concurrent orders reached" },
          "203": { "description": "Max cash in hand exceeded (COD)" }
        },
        "requestBody": false,
        "tags": ["Delivery Man Orders"]
      }
    },
    "/delivery-man/orders/{id}/status": {
      "put": {
        "summary": "Update order status",
        "description": "Driver progress: `picked_up`, `handover`, `delivered`, `canceled` (requires `reason`). **On `delivered`:** runs PHP-style settlement (`order_transactions`, `delivery_man_wallets`, COD cash, `payment_status=paid`). **406** if settlement fails.",
        "parameters": [
          { "$ref": "#/components/parameters/DeliveryManAuthorizationHeader" },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/DeliveryManUpdateOrderStatusBody" },
              "examples": {
                "picked_up": { "value": { "status": "picked_up" } },
                "delivered": { "value": { "status": "delivered" } },
                "canceled": { "value": { "status": "canceled", "reason": "Customer unreachable" } }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Status updated",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DeliveryManOrderStatusUpdateResponse" },
                "example": {
                  "status": true,
                  "msg": "Order status updated to delivered",
                  "data": { "id": "42", "order_status": "delivered" }
                }
              }
            }
          },
          "400": { "description": "Validation error or invalid transition" },
          "403": { "description": "Not your order or cancel not allowed" },
          "404": { "description": "Order not found" },
          "406": {
            "description": "Settlement failed (`create_order_transaction`) — order not marked delivered",
            "content": {
              "application/json": {
                "example": { "status": false, "msg": "Failed to create order transaction" }
              }
            }
          }
        },
        "tags": ["Delivery Man Orders"]
      }
    }
  },
  "components": {
    "parameters": {
      "DeliveryManAuthorizationHeader": {
        "name": "authorization",
        "in": "header",
        "required": true,
        "schema": { "type": "string" },
        "description": "Bearer JWT from POST /delivery-man/login",
        "example": "Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
      }
    },
    "schemas": {
      "DeliveryManLoginBody": {
        "type": "object",
        "required": ["phone", "password"],
        "properties": {
          "phone": { "type": "string", "minLength": 9, "example": "+972501234567" },
          "password": { "type": "string", "example": "Secret123!" },
          "remember_me": { "type": "boolean", "default": false }
        }
      },
      "DeliveryManLoginResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "boolean", "example": true },
          "msg": { "type": "string", "example": "Login success" },
          "data": {
            "type": "object",
            "properties": {
              "token": { "type": "string" },
              "topic": { "type": "string", "example": "delivery_man_2_1", "description": "FCM topic for new requests" },
              "id": { "type": "string" },
              "f_name": { "type": "string" },
              "l_name": { "type": "string" },
              "phone": { "type": "string" }
            }
          }
        }
      },
      "DeliveryManForgotPasswordBody": {
        "type": "object",
        "required": ["phone"],
        "properties": {
          "phone": { "type": "string", "example": "+972501234567" }
        }
      },
      "DeliveryManPasswordOtpBody": {
        "type": "object",
        "required": ["phone", "otp"],
        "properties": {
          "phone": { "type": "string", "example": "+972501234567" },
          "otp": { "type": "string", "pattern": "^\\d{4,6}$", "example": "1234" }
        }
      },
      "DeliveryManPasswordResetBody": {
        "type": "object",
        "required": ["phone", "otp", "password", "confirm_password"],
        "properties": {
          "phone": { "type": "string" },
          "otp": { "type": "string", "example": "1234" },
          "password": { "type": "string", "minLength": 6 },
          "confirm_password": { "type": "string", "minLength": 6 }
        }
      },
      "DeliveryManChangePasswordBody": {
        "type": "object",
        "required": ["current_password", "password", "confirm_password"],
        "properties": {
          "current_password": { "type": "string" },
          "password": { "type": "string", "minLength": 6 },
          "confirm_password": { "type": "string", "minLength": 6 }
        }
      },
      "DeliveryManEarningsResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "boolean", "example": true },
          "msg": { "type": "string", "example": "Success" },
          "data": {
            "type": "object",
            "properties": {
              "summary": { "$ref": "#/components/schemas/DeliveryManEarningsSummary" },
              "total_size": { "type": "integer" },
              "limit": { "type": "integer" },
              "offset": { "type": "integer" },
              "history": {
                "type": "array",
                "items": { "$ref": "#/components/schemas/DeliveryManEarningHistoryItem" }
              }
            }
          }
        }
      },
      "DeliveryManEarningsSummary": {
        "type": "object",
        "properties": {
          "wallet": {
            "type": "object",
            "properties": {
              "total_earning": { "type": "number" },
              "total_withdrawn": { "type": "number" },
              "pending_withdraw": { "type": "number" },
              "collected_cash": { "type": "number" },
              "balance": { "type": "number" }
            }
          },
          "todays_earning": { "type": "number" },
          "this_week_earning": { "type": "number" },
          "this_month_earning": { "type": "number" },
          "lifetime_earning": { "type": "number" }
        }
      },
      "DeliveryManEarningHistoryItem": {
        "type": "object",
        "properties": {
          "order_id": { "type": "string" },
          "transaction_id": { "type": "string", "nullable": true },
          "earned_at": { "type": "string", "format": "date-time" },
          "delivery_fee": { "type": "number" },
          "dm_tips": { "type": "number" },
          "total_earning": { "type": "number" },
          "order_amount": { "type": "number" },
          "restaurant_name": { "type": "string" },
          "item_name": { "type": "string" },
          "item_count": { "type": "integer" },
          "order": {
            "type": "object",
            "description": "Full order snapshot with items[]"
          }
        }
      },
      "DeliveryManHomeResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "boolean", "example": true },
          "msg": { "type": "string", "example": "Success" },
          "data": {
            "type": "object",
            "properties": {
              "todays_order_count": {
                "type": "integer",
                "example": 2,
                "description": "Orders accepted today"
              },
              "this_week_order_count": {
                "type": "integer",
                "example": 12,
                "description": "Orders accepted since start of week (Monday)"
              },
              "this_month_order_count": {
                "type": "integer",
                "example": 33,
                "description": "Orders accepted since start of calendar month"
              },
              "todays_earning": {
                "type": "number",
                "example": 522,
                "description": "Sum of original_delivery_charge + dm_tips for today's transactions"
              }
            }
          }
        }
      },
      "DeliveryManWhoamiResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "boolean", "example": true },
          "msg": { "type": "string", "example": "Success" },
          "data": {
            "type": "object",
            "description": "Delivery man record (id/zone_id as strings; no password)"
          }
        }
      },
      "DeliveryManMyOrdersResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "boolean", "example": true },
          "msg": { "type": "string", "example": "Success" },
          "data": {
            "type": "object",
            "properties": {
              "total_size": { "type": "integer", "example": 12 },
              "limit": { "type": "integer", "example": 10 },
              "offset": { "type": "integer", "example": 1, "description": "Current page" },
              "orders": {
                "type": "array",
                "items": { "$ref": "#/components/schemas/DeliveryManMyOrderCard" }
              }
            }
          }
        }
      },
      "DeliveryManMyOrderCard": {
        "type": "object",
        "description": "Figma order row — #id, title, item count, date/time, status pill, amount",
        "properties": {
          "id": { "type": "string", "example": "100178" },
          "order_id": { "type": "string", "example": "100178" },
          "item_name": { "type": "string", "example": "Classic Cheeseburger" },
          "item_count": { "type": "integer", "example": 5 },
          "image": { "type": "string", "example": "food/burger.png" },
          "order_amount": { "type": "number", "example": 300 },
          "order_status": { "type": "string", "example": "delivered" },
          "status_label": { "type": "string", "example": "Completed" },
          "order_date": { "type": "string", "example": "25 Aug, 2026" },
          "order_time": { "type": "string", "example": "18:35" },
          "restaurant_name": { "type": "string" }
        }
      },
      "DeliveryManOrderListResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "boolean", "example": true },
          "msg": { "type": "string", "example": "Success" },
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/DeliveryManOrderSummary" }
          }
        }
      },
      "DeliveryManOrderSummary": {
        "type": "object",
        "description": "Mapped order card for driver UI (restaurant, customer, amounts, address)",
        "properties": {
          "id": { "type": "string" },

{
  "components": {
    "schemas": {
      "FoodVariationOption": {
        "type": "object",
        "required": ["name", "price"],
        "properties": {
          "name": { "type": "string", "example": "Regular" },
          "price": { "type": "number", "example": 249 }
        }
      },
      "FoodVariationGroup": {
        "type": "object",
        "description": "Vendor write / raw DB may use `options` or `values`.",
        "required": ["name", "type", "required"],
        "properties": {
          "name": { "type": "string", "example": "Size" },
          "type": {
            "type": "string",
            "enum": ["single", "multi"],
            "example": "single"
          },
          "required": { "type": "boolean", "example": true },
          "min": { "type": "string", "example": "0" },
          "max": { "type": "string", "example": "4" },
          "selectionMode": {
            "type": "string",
            "enum": ["standard", "opt_out", "opt_in"]
          },
          "defaultSelectAll": { "type": "boolean" },
          "priceDisplay": { "type": "string", "enum": ["included", "price"] },
          "options": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/FoodVariationOption" }
          },
          "values": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/FoodVariationOption" }
          }
        }
      },
      "ConsumerFoodVariationOption": {
        "type": "object",
        "description": "StackFood / Flutter product model (`label`, `optionPrice`). For default included ingredients use optionPrice 0 with priceTag `included` and showPrice false.",
        "properties": {
          "label": { "type": "string", "example": "פיתה" },
          "name": { "type": "string", "example": "פיתה" },
          "level": { "type": "string", "example": "פיתה" },
          "optionPrice": { "type": "number", "example": 0 },
          "price": { "type": "number", "example": 0 },
          "priceTag": { "type": "string", "enum": ["included"], "example": "included" },
          "showPrice": { "type": "boolean", "example": false }
        }
      },
      "ConsumerFoodVariationGroup": {
        "type": "object",
        "description": "Consumer menu APIs always expose `values` (never rely on `options` alone).",
        "required": ["name", "type", "required", "values"],
        "properties": {
          "name": { "type": "string", "example": "במה תרצו לאכול?" },
          "type": {
            "type": "string",
            "enum": ["single", "multi"],
            "example": "single"
          },
          "required": {
            "type": "string",
            "enum": ["on", "off"],
            "example": "on"
          },
          "min": { "type": "string", "example": "0" },
          "max": { "type": "string", "example": "1" },
          "selectionMode": {
            "type": "string",
            "enum": ["standard", "opt_out", "opt_in"],
            "description": "opt_out = default ingredients (pre-selected, uncheck to remove). opt_in = paid upgrades with max cap."
          },
          "defaultSelectAll": {
            "type": "boolean",
            "description": "When true (opt_out groups), customer app pre-checks every option in this group."
          },
          "priceDisplay": {
            "type": "string",
            "enum": ["included", "price"],
            "description": "included → show Included label, not FREE."
          },
          "values": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ConsumerFoodVariationOption" }
          }
        }
      },
      "FoodAddonInput": {
        "type": "object",
        "required": ["name", "price"],
        "properties": {
          "id": {
            "type": "integer",
            "description": "Existing row in add_ons table (optional on update)",
            "example": 42
          },
          "name": { "type": "string", "example": "Extra cheese" },
          "price": { "type": "number", "minimum": 0, "example": 15 }
        }
      },
      "FoodAddonExpanded": {
        "type": "object",
        "required": ["id", "name", "price"],
        "properties": {
          "id": { "type": "integer", "example": 42 },
          "name": { "type": "string", "example": "Extra cheese" },
          "price": { "type": "number", "example": 15 },
          "status": { "type": "boolean", "example": true }
        }
      },
      "VendorFoodWriteBody": {
        "type": "object",
        "required": ["name", "category_id", "price"],
        "properties": {
          "name": { "type": "string", "example": "Margherita" },
          "description": { "type": "string", "example": "Tomato and mozzarella" },
          "image": { "type": "string", "example": "https://cdn.example.com/margherita.png" },
          "category_id": { "type": "integer", "example": 5 },
          "price": {
            "type": "number",
            "description": "Base price; when variations exist, usually the lowest option price",
            "example": 149
          },
          "restaurant_id": {
            "type": "integer",
            "description": "Optional — server sets from logged-in vendor if omitted",
            "example": 12
          },
          "variations": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/FoodVariationGroup" }
          },
          "add_ons": {
            "type": "array",
            "description": "Optional extras. Send { name, price, id? }; persisted as add_ons table IDs linked to the food.",
            "items": {
              "oneOf": [
                { "type": "integer", "description": "Legacy: add_ons id only" },
                { "$ref": "#/components/schemas/FoodAddonInput" }
              ]
            },
            "example": [{ "name": "Extra cheese", "price": 15 }]
          },
          "status": { "type": "boolean", "example": true },
          "is_draft": { "type": "integer", "enum": [0, 1], "example": 0 },
          "available_time_starts": {
            "type": "string",
            "nullable": true,
            "example": "08:00:00",
            "description": "When this item may be sold (business timezone). Omit or null with `available_time_ends` for all-day."
          },
          "available_time_ends": {
            "type": "string",
            "nullable": true,
            "example": "11:00:00",
            "description": "End of selling window (inclusive), HH:mm:ss in business timezone."
          }
        }
      },
      "VendorFoodItem": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "101" },
          "name": { "type": "string", "example": "Margherita" },
          "description": { "type": "string" },
          "image": { "type": "string" },
          "category_id": { "type": "integer" },
          "price": { "type": "number", "example": 149 },
          "restaurant_id": { "type": "integer" },
          "status": { "type": "boolean" },
          "is_draft": { "type": "integer" },
          "variations": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/FoodVariationGroup" }
          },
          "add_ons": {
            "type": "array",
            "description": "Expanded from linked add_ons ids",
            "items": { "$ref": "#/components/schemas/FoodAddonExpanded" }
          },
          "available_time_starts": { "type": "string", "nullable": true, "example": "08:00:00" },
          "available_time_ends": { "type": "string", "nullable": true, "example": "11:00:00" }
        }
      },
      "ConsumerFoodAvailabilityStatus": {
        "type": "string",
        "enum": ["all_day", "available", "not_yet_available", "time_ended"],
        "description": "`all_day` — no restriction (or full-day window). `available` — inside window. `not_yet_available` — before window. `time_ended` — after window. Evaluated in business timezone."
      },
      "ConsumerFoodSellingTimeFields": {
        "type": "object",
        "description": "Per-item selling window (vendor-configured). Present on consumer menu/product payloads when formatted with selling-time metadata.",
        "properties": {
          "available_time_starts": {
            "type": "string",
            "nullable": true,
            "example": "08:00:00",
            "description": "Configured window start (HH:mm:ss), or null when all-day."
          },
          "available_time_ends": {
            "type": "string",
            "nullable": true,
            "example": "11:00:00",
            "description": "Configured window end (HH:mm:ss), or null when all-day."
          },
          "is_available_now": {
            "type": "boolean",
            "example": true,
            "description": "Whether the item can be added to cart at request time (or at scheduled order time on checkout)."
          },
          "availability_status": {
            "$ref": "#/components/schemas/ConsumerFoodAvailabilityStatus"
          }
        }
      },
      "AiMenuParsedFoodItem": {
        "type": "object",
        "required": ["name", "description", "price", "variations", "add_ons"],
        "properties": {
          "name": { "type": "string", "example": "Margherita" },
          "description": { "type": "string", "example": "Classic tomato and mozzarella" },
          "price": { "type": "number", "example": 149 },
          "variations": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/FoodVariationGroup" }
          },
          "add_ons": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/FoodAddonInput" }
          }
        }
      },
      "AiMenuParseData": {
        "type": "object",
        "required": ["categories"],
        "properties": {
          "categories": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "items"],
              "properties": {
                "name": { "type": "string", "example": "Pizza" },
                "items": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/AiMenuParsedFoodItem" }
                }
              }
            }
          }
        }
      },
      "ConsumerMenuFoodItem": {
        "type": "object",
        "description": "Menu / product card for the customer app. Includes selling-time fields when returned from consumer food endpoints.",
        "properties": {
          "id": { "type": "string", "example": "101" },
          "name": { "type": "string", "example": "Margherita" },
          "description": { "type": "string" },
          "image": { "type": "string" },
          "image_full_url": { "type": "string", "nullable": true },
          "category_id": { "type": "string", "nullable": true },
          "restaurant_id": { "type": "string", "nullable": true },
          "restaurant_name": { "type": "string", "nullable": true },
          "price": { "type": "number", "example": 149 },
          "discount": { "type": "number", "example": 0 },
          "discount_type": { "type": "string", "example": "percent" },
          "veg": { "type": "boolean" },
          "status": { "type": "boolean" },
          "variations": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ConsumerFoodVariationGroup" }
          },
          "add_ons": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/FoodAddonExpanded" }
          },
          "available_time_starts": {
            "type": "string",
            "nullable": true,
            "example": "08:00:00"
          },
          "available_time_ends": {
            "type": "string",
            "nullable": true,
            "example": "11:00:00"
          },
          "is_available_now": { "type": "boolean", "example": true },
          "availability_status": {
            "$ref": "#/components/schemas/ConsumerFoodAvailabilityStatus"
          }
        }
      },
      "ConsumerFoodListPage": {
        "type": "object",
        "properties": {
          "status": { "type": "boolean", "example": true },
          "total_size": { "type": "integer", "example": 24 },
          "limit": { "type": "integer", "example": 10 },
          "offset": { "type": "integer", "example": 1 },
          "products": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ConsumerMenuFoodItem" }
          }
        }
      }
    }
  },
  "paths": {
    "/vendor/catalog/food": {
      "post": {
        "summary": "Create food item",
        "description": "Creates a menu item with JSON **variations** (size/choice groups) and **add_ons** (optional extras). Add-ons are synced to the `add_ons` table and linked by id on the food record.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/VendorFoodWriteBody" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "boolean", "example": true },
                    "msg": { "type": "string", "example": "Food item created successfully" },
                    "data": { "$ref": "#/components/schemas/VendorFoodItem" }
                  }
                },
                "example": {
                  "status": true,
                  "msg": "Food item created successfully",
                  "data": {
                    "id": "101",
                    "name": "Margherita",
                    "price": 149,
                    "variations": [
                      {
                        "name": "Size",
                        "type": "single",
                        "required": true,
                        "options": [
                          { "name": "Personal", "price": 149 },
                          { "name": "Regular", "price": 249 },
                          { "name": "Large", "price": 399 }
                        ]
                      }
                    ],
                    "add_ons": [{ "id": 42, "name": "Extra cheese", "price": 15, "status": true }]
                  }
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "List vendor food items",
        "description": "Returns foods for the authenticated vendor's restaurant. **add_ons** are expanded objects (id, name, price), not raw id arrays.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "boolean", "example": true },
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/VendorFoodItem" }
                    },
                    "pagination": { "type": "object" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/vendor/catalog/food/{id}": {
      "patch": {
        "summary": "Update food item",
        "description": "Partial update. When **add_ons** is sent, extras are synced to the add_ons catalog and food links are replaced with the resulting ids.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/VendorFoodWriteBody" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "boolean" },
                    "msg": { "type": "string" },
                    "data": { "$ref": "#/components/schemas/VendorFoodItem" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/vendor/catalog/ai/parse-pdf": {
      "post": {
        "summary": "AI parse menu image or PDF",
        "description": "Upload a menu file (`multipart/form-data` field **file**). Gemini extracts categories, items, **variations** (e.g. Personal/Regular/Large price columns as one Size group per item), and **add_ons** (optional paid extras). Requires `GEMINI_API_KEY` on the server.",
        "responses": {
          "200": {
            "description": "Parsed menu structure",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "boolean", "example": true },
                    "data": { "$ref": "#/components/schemas/AiMenuParseData" }
                  }
                },
                "example": {
                  "status": true,
                  "data": {
                    "categories": [
                      {
                        "name": "Pizza",
                        "items": [
                          {
                            "name": "Margherita",
                            "description": "Classic tomato and mozzarella",
                            "price": 149,
                            "variations": [
                              {
                                "name": "Size",
                                "type": "single",
                                "required": true,
                                "options": [
                                  { "name": "Personal", "price": 149 },
                                  { "name": "Regular", "price": 249 },
                                  { "name": "Large", "price": 399 }
                                ]
                              }
                            ],
                            "add_ons": [{ "name": "Extra cheese", "price": 15 }]
                          }
                        ]
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/consumer/restaurants/{id}/foods": {
      "get": {
        "summary": "Restaurant menu foods",
        "description": "Paginated foods for a restaurant. Each item includes **variations** (groups with **`values`**, StackFood-compatible), expanded **add_ons** (`id`, `name`, `price`), and **selling-time** fields (`available_time_starts`, `available_time_ends`, `is_available_now`, `availability_status`) when the vendor set a time window.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "boolean", "example": true },
                    "data": {
                      "type": "object",
                      "properties": {
                        "foods": {
                          "type": "array",
                          "items": { "$ref": "#/components/schemas/ConsumerMenuFoodItem" }
                        },
                        "total_size": { "type": "integer" },
                        "limit": { "type": "integer" },
                        "offset": { "type": "integer" }
                      }
                    }
                  }
                },
                "example": {
                  "status": true,
                  "data": {
                    "total_size": 1,
                    "limit": 20,
                    "offset": 1,
                    "foods": [
                      {
                        "id": "101",
                        "name": "Margherita",
                        "price": 149,
                        "variations": [
                          {
                            "name": "Size",
                            "type": "single",
                            "required": "on",
                            "min": "0",
                            "max": "1",
                            "values": [
                              {
                                "label": "Personal",
                                "name": "Personal",
                                "level": "Personal",
                                "optionPrice": 0,
                                "price": 0
                              },
                              {
                                "label": "Regular",
                                "name": "Regular",
                                "level": "Regular",
                                "optionPrice": 10,
                                "price": 10
                              }
                            ]
                          }
                        ],
                        "add_ons": [{ "id": 42, "name": "Extra cheese", "price": 15, "status": true }],
                        "available_time_starts": null,
                        "available_time_ends": null,
                        "is_available_now": true,
                        "availability_status": "all_day"
                      },
                      {
                        "id": "102",
                        "name": "Morning Shakshuka",
                        "price": 45,
                        "available_time_starts": "08:00:00",
                        "available_time_ends": "11:00:00",
                        "is_available_now": false,
                        "availability_status": "time_ended",
                        "variations": [],
                        "add_ons": []
                      },
                      {
                        "id": "9001",
                        "name": "TEST Burger Box",
                        "price": 59,
                        "variations": [
                          {
                            "name": "Ingredients to Remove",
                            "type": "multi",
                            "required": "off",
                            "min": "0",
                            "max": "999",
                            "selectionMode": "opt_out",
                            "defaultSelectAll": true,
                            "priceDisplay": "included",
                            "values": [
                              {
                                "label": "Asado",
                                "optionPrice": 0,
                                "price": 0,
                                "priceTag": "included",
                                "showPrice": false
                              },
                              {
                                "label": "Onion",
                                "optionPrice": 0,
                                "price": 0,
                                "priceTag": "included",
                                "showPrice": false
                              }
                            ]
                          },
                          {
                            "name": "Paid Upgrades",
                            "type": "multi",
                            "required": "off",
                            "min": "0",
                            "max": "4",
                            "selectionMode": "opt_in",
                            "defaultSelectAll": false,
                            "priceDisplay": "price",
                            "values": [
                              { "label": "Extra Cheese", "optionPrice": 5, "price": 5, "showPrice": true },
                              { "label": "Egg", "optionPrice": 4, "price": 4, "showPrice": true }
                            ]
                          }
                        ],
                        "add_ons": []
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/consumer/foods/details/{id}": {
      "get": {
        "summary": "Food product details",
        "description": "Single active food item. Response `data` is a **ConsumerMenuFoodItem** including selling-time fields (`available_time_starts`, `available_time_ends`, `is_available_now`, `availability_status`). Times use the business timezone from config.",
        "tags": ["Consumer Foods"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "example": 102 }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "boolean", "example": true },
                    "data": { "$ref": "#/components/schemas/ConsumerMenuFoodItem" }
                  }
                },
                "example": {
                  "status": true,
                  "data": {
                    "id": "102",
                    "name": "Morning Shakshuka",
                    "description": "Eggs in spiced tomato sauce",
                    "price": 45,
                    "veg": true,
                    "status": true,
                    "variations": [],
                    "add_ons": [],
                    "available_time_starts": "08:00:00",
                    "available_time_ends": "11:00:00",
                    "is_available_now": false,
                    "availability_status": "time_ended"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Food not found or inactive"
          }
        }
      }
    },
    "/consumer/foods/latest": {
      "get": {
        "summary": "Latest foods (paginated list)",
        "description": "Same product shape as menu items. Each entry in **`products`** includes selling-time fields when configured.",
        "tags": ["Consumer Foods"],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ConsumerFoodListPage" }
              }
            }
          }
        }
      }
    },
    "/consumer/foods/popular": {
      "get": {
        "summary": "Popular foods in zone",
        "description": "Paginated **`products`** array; each item is **ConsumerMenuFoodItem** with selling-time metadata.",
        "tags": ["Consumer Foods"],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ConsumerFoodListPage" }
              }
            }
          }
        }
      }
    }
  }
}

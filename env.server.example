# Server ~/gizra-app-backend/.env
#
# Same password + database as Mac. Host differs (see below):
#   Server API (Docker):  @postgres:5432   — most reliable for the backend container
#   Mac npm run dev:      @167.233.245.44:5434
#
# If you use @167.233.245.44 on the server too (copy-paste from Mac), prod often still
# works but ./scripts/verify-db-docker.sh may falsely fail (hairpin). Prefer postgres:5432 here.

PORT=3000
DATABASE_URL=postgresql://postgres:mysecretpassword@postgres:5432/gizra_db?schema=public
REDIS_URL=redis://redis:6379
JWT_SECRET=change_me_to_a_long_random_string

CLOUDFLARE_TUNNEL_TOKEN=
GEMINI_API_KEY=

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ACCESS_KEY_ID=
CLOUDFLARE_SECRET_ACCESS_KEY=
CLOUDFLARE_BUCKET_NAME=
CLOUDFLARE_PUBLIC_URL=

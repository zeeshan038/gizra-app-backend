{
  "tags": [
    {
      "name": "Consumer Coupons",
      "description": "Coupon list, apply validation, and public restaurant-wise coupons. **Zone:** pass query `zone_id` from `GET /consumer/config/zone-id` (required for list & restaurant-wise). Errors: `{ \"status\": false, \"msg\": \"...\" }`."
    }
  ],
  "paths": {
    "/consumer/coupon/restaurant-wise": {
      "get": {
        "summary": "Public coupons for a restaurant (restaurant detail / checkout)",
        "description": "Legacy PHP `GET /api/v1/coupon/restaurant-wise-coupon`. **No JWT.** Returns only coupons eligible for **all customers** (`customer_id` includes `\"all\"`).\n\n**Required query:** `zone_id`, `restaurant_id`.",
        "tags": ["Consumer Coupons"],
        "parameters": [
          { "$ref": "#/components/parameters/ConsumerZoneIdQuery" },
          {
            "name": "restaurant_id",
            "in": "query",
            "required": true,
            "schema": { "type": "integer", "example": 3 },
            "description": "Restaurant id shown on the screen"
          }
        ],
        "responses": {
          "200": {
            "description": "Array of applicable coupons (may be empty)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/ConsumerCouponItem" }
                },
                "example": [
                  {
                    "id": 12,
                    "title": "10% off",
                    "code": "SAVE10",
                    "start_date": "2026-01-01T00:00:00.000Z",
                    "expire_date": "2026-12-31T00:00:00.000Z",
                    "min_purchase": 50,
                    "max_discount": 25,
                    "discount": 10,
                    "discount_type": "percent",
                    "coupon_type": "restaurant_wise",
                    "limit": 1,
                    "status": true,
                    "data": "Pizza Palace",
                    "total_uses": 0,
                    "created_by": "admin",
                    "customer_id": "[\"all\"]",
                    "slug": null,
                    "restaurant_id": null,
                    "restaurant": null,
                    "created_at": "2026-01-01T00:00:00.000Z",
                    "updated_at": "2026-01-01T00:00:00.000Z"
                  }
                ]
              }
            }
          },
          "403": {
            "description": "Missing zone_id, invalid restaurant_id, or server error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiError" },
                "examples": {
                  "zoneRequired": {
                    "summary": "No zone_id",
                    "value": { "status": false, "msg": "Zone id is required" }
                  },
                  "restaurantRequired": {
                    "summary": "Missing restaurant_id",
                    "value": { "status": false, "msg": "Restaurant id is required" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/consumer/coupon/list": {
      "get": {
        "summary": "Logged-in customer coupon list",
        "description": "Legacy PHP `GET /api/v1/coupon/list`. **Bearer JWT** (registered customer, not guest). Filters by zone and customer eligibility.\n\n**Required:** `zone_id`. **Optional:** `restaurant_id` to narrow vendor/admin coupons for one restaurant.",
        "tags": ["Consumer Coupons"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/ConsumerZoneIdQuery" },
          { "$ref": "#/components/parameters/ConsumerAuthorizationHeader" },
          {
            "name": "restaurant_id",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "example": 3 },
            "description": "When set, only coupons for this restaurant (or restaurant_wise including it)"
          }
        ],
        "responses": {
          "200": {
            "description": "Array of coupons the customer can use",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/ConsumerCouponItem" }
                }
              }
            }
          },
          "401": {
            "description": "Missing/invalid JWT or guest",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiError" },
                "example": { "status": false, "msg": "Login required" }
              }
            }
          },
          "403": {
            "description": "Missing zone_id or validation error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiError" },
                "example": { "status": false, "msg": "Zone id is required" }
              }
            }
          }
        }
      }
    },
    "/consumer/coupon/apply": {
      "get": {
        "summary": "Validate coupon before checkout",
        "description": "Legacy PHP `GET /api/v1/coupon/apply`. **Bearer JWT** (registered). Checks code, dates, eligibility, restaurant/zone rules, and usage limits. Use before place-order with the same `coupon_code`.\n\n**Query:** `code`, `restaurant_id` (required).",
        "tags": ["Consumer Coupons"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/ConsumerAuthorizationHeader" },
          {
            "name": "code",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "example": "SAVE10" }
          },
          {
            "name": "restaurant_id",
            "in": "query",
            "required": true,
            "schema": { "type": "integer", "example": 3 }
          }
        ],
        "responses": {
          "200": {
            "description": "Coupon is valid — same shape as list items",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ConsumerCouponItem" },
                "example": {
                  "id": 12,
                  "title": "10% off",
                  "code": "SAVE10",
                  "start_date": "2026-01-01T00:00:00.000Z",
                  "expire_date": "2026-12-31T00:00:00.000Z",
                  "min_purchase": 50,
                  "max_discount": 25,
                  "discount": 10,
                  "discount_type": "percent",
                  "coupon_type": "default",
                  "limit": 1,
                  "status": true,
                  "data": null,
                  "total_uses": 0,
                  "created_by": "vendor",
                  "customer_id": "[\"all\"]",
                  "slug": null,
                  "restaurant_id": 3,
                  "restaurant": { "id": 3, "name": "Pizza Palace" },
                  "created_at": "2026-01-01T00:00:00.000Z",
                  "updated_at": "2026-01-01T00:00:00.000Z"
                }
              }
            }
          },
          "403": {
            "description": "Not eligible or validation failed",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiError" },
                "example": { "status": false, "msg": "You are not eligible for this coupon" }
              }
            }
          },
          "404": {
            "description": "Unknown code or coupon not valid for this restaurant",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiError" },
                "example": { "status": false, "msg": "Coupon not found" }
              }
            }
          },
          "406": {
            "description": "Usage limit reached",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiError" },
                "example": { "status": false, "msg": "Coupon usage limit over" }
              }
            }
          },
          "407": {
            "description": "Coupon expired (PHP parity status code)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiError" },
                "example": { "status": false, "msg": "Coupon expired" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ConsumerCouponItem": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "title": { "type": "string", "nullable": true },
          "code": { "type": "string", "nullable": true },
          "start_date": { "type": "string", "format": "date-time", "nullable": true },
          "expire_date": { "type": "string", "format": "date-time", "nullable": true },
          "min_purchase": { "type": "number" },
          "max_discount": { "type": "number" },
          "discount": { "type": "number" },
          "discount_type": { "type": "string", "description": "percent | amount (etc.)" },
          "coupon_type": {
            "type": "string",
            "description": "default | restaurant_wise | zone_wise | first_order | …"
          },
          "limit": { "type": "integer", "nullable": true, "description": "Max uses per customer when set" },
          "status": { "type": "boolean" },
          "data": {
            "nullable": true,
            "description": "JSON string or restaurant name label depending on coupon_type"
          },
          "total_uses": { "type": "integer" },
          "created_by": { "type": "string", "enum": ["admin", "vendor"] },
          "customer_id": { "type": "string", "nullable": true, "description": "JSON array e.g. [\"all\"] or customer ids" },
          "slug": { "type": "string", "nullable": true },
          "restaurant_id": { "type": "integer", "nullable": true },
          "restaurant": {
            "type": "object",
            "nullable": true,
            "properties": {
              "id": { "type": "integer" },
              "name": { "type": "string" }
            }
          },
          "created_at": { "type": "string", "format": "date-time", "nullable": true },
          "updated_at": { "type": "string", "format": "date-time", "nullable": true }
        }
      }
    }
  }
}

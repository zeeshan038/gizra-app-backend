# =============================================================================
# Gizra production server — ~/gizra-app-backend/.env
# =============================================================================
#
# PERMANENT MODEL (do not fight this):
#   • ONE password lives in DATABASE_URL below (same password on your Mac .env for :5434).
#   • Prod API container NEVER uses that host — it uses postgres:5432 + Docker pg_hba trust.
#   • Mac dev uses @167.233.245.44:5434 with the password in the URL.
#   • Never copy the whole Mac .env here (REDIS_URL here must be redis://redis:6379).
#
# ONE-TIME (or after any DB/auth mess) — on the server:
#   cd ~/gizra-app-backend
#   unset DATABASE_URL POSTGRES_PASSWORD
#   git pull origin zeeshan-dev
#   npm run fix:prod-db
#   curl -s https://backend-prod.gizra.app/api/health/db   # must be "db":"ok"
#
# EVERY CODE DEPLOY (only command you need day-to-day):
#   cd ~/gizra-app-backend
#   unset DATABASE_URL POSTGRES_PASSWORD
#   git pull origin zeeshan-dev
#   npm run deploy:server
#
# MONITOR (bookmark):
#   https://backend-prod.gizra.app/api/health/db
#
# OPTIONAL — auto-heal on server (users never SSH; cron fixes DB before long outages):
#   sudo touch /var/log/gizra-auto-heal.log && sudo chown $(whoami) /var/log/gizra-auto-heal.log
#   crontab -e
#   */5 * * * * cd ~/gizra-app-backend && npm run prod:auto-heal >/dev/null 2>&1
#
# NEVER on the server:
#   • docker compose up … without npm run deploy:server / npm run compose
#   • export DATABASE_URL=… or POSTGRES_PASSWORD=… before compose
#   • sed/deleting DATABASE_URL from .env
#   • docker compose down (drops nothing by itself but avoid unless you mean it)
#   • routine repair:prod-stack when health is already ok
#
# =============================================================================

PORT=3000
DATABASE_URL=postgresql://postgres:mysecretpassword@167.233.245.44:5434/gizra_db?schema=public
REDIS_URL=redis://redis:6379
JWT_SECRET=change_me_to_a_long_random_string

CLOUDFLARE_TUNNEL_TOKEN=
GEMINI_API_KEY=

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ACCESS_KEY_ID=
CLOUDFLARE_SECRET_ACCESS_KEY=
CLOUDFLARE_BUCKET_NAME=
CLOUDFLARE_PUBLIC_URL=

# Copy to `.env` on the server (and locally when using Docker Compose).

# Server Docker: host `postgres` | Mac dev: host `127.0.0.1` port 5434 (see env.example)
DATABASE_URL=postgresql://postgres:your_db_password_here@postgres:5432/gizra_db?schema=public

REDIS_URL=redis://redis:6379
JWT_SECRET=change_me
CLOUDFLARE_TUNNEL_TOKEN=
GEMINI_API_KEY=

# Cloudflare R2 Storage
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ACCESS_KEY_ID=
CLOUDFLARE_SECRET_ACCESS_KEY=
CLOUDFLARE_BUCKET_NAME=
CLOUDFLARE_PUBLIC_URL=

# Firebase Cloud Messaging (service account JSON from Firebase Console → Project settings → Service accounts)
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# If P1000 / login fails: password in volume ≠ DATABASE_URL — run once on server:
#   npm run repair:prod-stack

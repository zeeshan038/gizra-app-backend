# Copy to `.env` on the server (and locally when using Docker Compose).
# Compose injects these into containers — editing .env + recreate backend is required.

# --- Docker Compose (server): ONLY set POSTGRES_PASSWORD — Compose builds DATABASE_URL for the API container ---
POSTGRES_PASSWORD=your_db_password_here
# Do not set DATABASE_URL for Docker deploys (docker-compose.yml overrides it from POSTGRES_PASSWORD).

# --- Mac: `npm run dev` via SSH tunnel (NOT the server public IP — P1001 if you use 167.x:5434) ---
# ssh -N -L 5434:127.0.0.1:5434 root@YOUR_SERVER
# DATABASE_URL=postgresql://postgres:your_db_password_here@127.0.0.1:5434/gizra_db?schema=public

REDIS_URL=redis://redis:6379
JWT_SECRET=change_me
CLOUDFLARE_TUNNEL_TOKEN=
GEMINI_API_KEY=

# Cloudflare R2 Storage
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ACCESS_KEY_ID=
CLOUDFLARE_SECRET_ACCESS_KEY=
CLOUDFLARE_BUCKET_NAME=
CLOUDFLARE_PUBLIC_URL=

# Firebase Cloud Messaging (service account JSON from Firebase Console → Project settings → Service accounts)
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# If P1000 / login 503: run on server: ./scripts/sync-postgres-password.sh
# (uses peer auth — do not use psql -U postgres from root without -u postgres)

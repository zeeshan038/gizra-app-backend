{
  "components": {
    "schemas": {
      "AdminHomeCategoryWriteBody": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": ["category", "restaurant"],
            "default": "category",
            "description": "category = menu tile with optional multi-restaurant assign; restaurant = single-restaurant shortcut tile"
          },
          "name": {
            "type": "string",
            "description": "Required for type=category. Optional for type=restaurant (defaults to restaurant name)."
          },
          "restaurant_id": {
            "type": "integer",
            "description": "Required when type=restaurant"
          },
          "image": { "type": "string" },
          "priority": { "type": "integer", "minimum": 0 },
          "status": { "type": "boolean" }
        }
      },
      "AdminHomeCategoryItem": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "image": { "type": "string" },
          "image_full_url": { "type": "string", "nullable": true },
          "slug": { "type": "string", "nullable": true },
          "priority": { "type": "integer" },
          "status": { "type": "boolean" },
          "type": { "type": "string", "enum": ["category", "restaurant"] },
          "restaurantID": { "type": "string", "nullable": true },
          "restaurantName": { "type": "string", "nullable": true },
          "restaurants_count": { "type": "integer" },
          "restaurant_ids": {
            "type": "array",
            "items": { "type": "integer" }
          }
        }
      }
    }
  },
  "paths": {
    "/admin/home-categories": {
      "get": {
        "summary": "List home categories",
        "description": "Customer **What's on your mind** tiles. Each item includes **type** (`category` | `restaurant`), and for restaurant tiles **restaurantID** + **restaurantName**."
      },
      "post": {
        "summary": "Create home category tile",
        "description": "Create a marketplace home tile. Use **type=restaurant** + **restaurant_id** for a shortcut that opens one restaurant; **type=category** (default) for a normal category tile (assign restaurants separately).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AdminHomeCategoryWriteBody" },
              "examples": {
                "category": {
                  "value": {
                    "type": "category",
                    "name": "בשרי",
                    "priority": 10,
                    "status": true
                  }
                },
                "restaurant": {
                  "value": {
                    "type": "restaurant",
                    "restaurant_id": 12,
                    "name": "Nickel Barn",
                    "priority": 5,
                    "status": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "example": {
                  "status": true,
                  "msg": "Home category created successfully",
                  "data": {
                    "id": "42",
                    "name": "Nickel Barn",
                    "type": "restaurant",
                    "restaurantID": "12",
                    "restaurantName": "Nickel Barn",
                    "priority": 5,
                    "status": true,
                    "restaurants_count": 1,
                    "restaurant_ids": [12]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/admin/home-categories/{id}": {
      "patch": {
        "summary": "Update home category tile",
        "description": "Partial update. Send **type** + **restaurant_id** to convert to or update a restaurant shortcut; **type=category** clears single-restaurant link and restores a normal category slug.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AdminHomeCategoryWriteBody" }
            }
          }
        }
      }
    }
  }
}

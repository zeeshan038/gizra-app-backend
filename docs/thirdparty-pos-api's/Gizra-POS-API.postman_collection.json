{
  "info": {
    "name": "Gizra Third-Party POS API",
    "description": "Sandbox test collection for POS partner + Super Admin setup.\n\n1) Run Admin Login\n2) Create API Key (copy token into posToken)\n3) Create Connection (use webhook.site URL)\n4) Set orderId to a pending order\n5) Get / Accept / Reject",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "adminEmail", "value": "" },
    { "key": "adminPassword", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "posToken", "value": "" },
    { "key": "restaurantId", "value": "3" },
    { "key": "webhookUrl", "value": "https://webhook.site/replace-me" },
    { "key": "orderId", "value": "" },
    { "key": "apiKeyId", "value": "" },
    { "key": "connectionId", "value": "" }
  ],
  "item": [
    {
      "name": "1. Admin Setup",
      "item": [
        {
          "name": "Admin Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "const token = json?.data?.token || json?.token;",
                  "if (token) pm.collectionVariables.set('adminToken', token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/admin/auth/login"
          }
        },
        {
          "name": "Create POS API Key",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json?.data?.token) pm.collectionVariables.set('posToken', json.data.token);",
                  "if (json?.data?.id) pm.collectionVariables.set('apiKeyId', json.data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"restaurant_id\": {{restaurantId}},\n  \"name\": \"Sandbox POS Test\",\n  \"provider\": \"verifone\",\n  \"environment\": \"sandbox\",\n  \"scopes\": [\"orders:read\", \"orders:write\"]\n}"
            },
            "url": "{{baseUrl}}/api/admin/pos/api-keys"
          }
        },
        {
          "name": "List POS API Keys",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/admin/pos/api-keys?restaurant_id={{restaurantId}}"
          }
        },
        {
          "name": "Create POS Connection",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json?.data?.id) pm.collectionVariables.set('connectionId', json.data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"restaurant_id\": {{restaurantId}},\n  \"url\": \"{{webhookUrl}}\",\n  \"provider\": \"verifone\",\n  \"external_merchant_id\": \"TEST-MERCHANT-001\",\n  \"events\": [\"order.created\"],\n  \"active\": true\n}"
            },
            "url": "{{baseUrl}}/api/admin/pos/connections"
          }
        },
        {
          "name": "List POS Connections",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/admin/pos/connections?restaurant_id={{restaurantId}}"
          }
        },
        {
          "name": "List Webhook Deliveries",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/admin/pos/deliveries?order_id={{orderId}}"
          }
        }
      ]
    },
    {
      "name": "2. POS Partner APIs",
      "item": [
        {
          "name": "List Orders",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{posToken}}" }],
            "url": "{{baseUrl}}/api/v1/pos/orders?status=pending&limit=20&offset=0"
          }
        },
        {
          "name": "Get Order",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{posToken}}" }],
            "url": "{{baseUrl}}/api/v1/pos/orders/{{orderId}}"
          }
        },
        {
          "name": "Accept Order",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{posToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{}" },
            "url": "{{baseUrl}}/api/v1/pos/orders/{{orderId}}/accept"
          }
        },
        {
          "name": "Reject Order",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{posToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Out of stock\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/pos/orders/{{orderId}}/reject"
          }
        }
      ]
    }
  ]
}

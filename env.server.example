# Server ~/gizra-app-backend/.env
#
# ONE password source: DATABASE_URL (same password on Mac dev; Mac may use host 167.x:5434).
# Docker backend NEVER uses that host — deploy generates .env.compose → postgres:5432 automatically.
#
# Deploy (code + DB password sync, no volume wipe):
#   unset DATABASE_URL POSTGRES_PASSWORD
#   git pull origin zeeshan-dev
#   npm run deploy:server
#
# If deploy fails on DB auth: npm run repair:prod-stack once, then deploy again.

PORT=3000
DATABASE_URL=postgresql://postgres:mysecretpassword@167.233.245.44:5434/gizra_db?schema=public
REDIS_URL=redis://redis:6379
JWT_SECRET=change_me_to_a_long_random_string

CLOUDFLARE_TUNNEL_TOKEN=
GEMINI_API_KEY=

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ACCESS_KEY_ID=
CLOUDFLARE_SECRET_ACCESS_KEY=
CLOUDFLARE_BUCKET_NAME=
CLOUDFLARE_PUBLIC_URL=

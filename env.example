# Use the right template:
#   Mac:    cp env.mac.example .env
#   Server: cp env.server.example .env   (in ~/gizra-app-backend on Hetzner)
#
# One shared Postgres PASSWORD in both files; hosts differ (see below).

DATABASE_URL=postgresql://postgres:your_db_password_here@127.0.0.1:5434/gizra_db?schema=public
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=change_me
GEMINI_API_KEY=

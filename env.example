# Mac → prod DB: tunnel (stable) then use 127.0.0.1 — not the public IP.
#   ssh -N -L 5434:127.0.0.1:5434 root@167.233.245.44
DATABASE_URL=postgresql://postgres:your_db_password_here@127.0.0.1:5434/gizra_db?schema=public

# Server ~/gizra-app-backend/.env: @167.233.245.44:5434 or @postgres:5432

# Server Docker stack only (Mac dev can use localhost if you run redis locally):
REDIS_URL=redis://redis:6379
# Mac optional: REDIS_URL=redis://167.233.245.44:6380

JWT_SECRET=change_me
CLOUDFLARE_TUNNEL_TOKEN=
GEMINI_API_KEY=

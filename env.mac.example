# =============================================================================
# Mac local dev — copy to gizra-backend/.env (NOT on the server)
# =============================================================================
#
# Same Postgres DATA as prod: SSH tunnel, then 127.0.0.1:5434 (same password as server).
#
#   Terminal A (leave open):
#     ./scripts/mac-db-tunnel.sh
#     # or: ssh -N -L 5434:127.0.0.1:5434 root@167.233.245.44
#
#   Terminal B:
#     npm run dev
#
# Password MUST match ~/gizra-app-backend/.env on Hetzner (only the password string).
# Host MUST be 127.0.0.1 while the tunnel is open — not 167.x on Mac.
#
# =============================================================================

DATABASE_URL=postgresql://postgres:YOUR_SAME_PASSWORD_AS_SERVER@127.0.0.1:5434/gizra_db?schema=public

# PHP prod MySQL (CyberPanel) — read-only from Mac via SSH tunnel (no panel shell needed):
#   Terminal: ./scripts/mac-mysql-panel-tunnel.sh   → localhost:3308
#   Count:    ./scripts/mac-mysql-panel-count.sh orders
#   Dump:     ./scripts/mac-mysql-panel-dump.sh ~/Downloads/gizra_mysql_prod.sql
# URL-encode special chars in password (* → %2A). After dump, import locally and use root@gizra_db:
# MYSQL_MIGRATION_URL=mysql://DB_USER:DB_PASS@127.0.0.1:3308/DB_NAME
# MYSQL_MIGRATION_URL=mysql://root:migrate_local_root@127.0.0.1:3306/gizra_db

# Redis: run locally (recommended) so prod Redis is untouched
REDIS_URL=redis://127.0.0.1:6379
# Or: docker run -d --name gizra-redis-local -p 6379:6379 redis:7

JWT_SECRET=dev_or_match_prod_if_testing_auth
GEMINI_API_KEY=

# Same R2 keys as prod if you test uploads locally
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ACCESS_KEY_ID=
CLOUDFLARE_SECRET_ACCESS_KEY=
CLOUDFLARE_BUCKET_NAME=
CLOUDFLARE_PUBLIC_URL=

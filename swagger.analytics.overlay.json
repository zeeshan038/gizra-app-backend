{
  "tags": [
    {
      "name": "Consumer Analytics",
      "description": "In-app funnel events for Super Admin + abandoned-cart timer.\n\n**Docs:** `docs/FLUTTER-ANALYTICS-ABANDONED-CART.md`\n\n**Auth:** Consumer Bearer JWT (or guest token / `is_guest` + `guest_id`).\n\nEvent names: `app_opened`, `store_viewed`, `product_viewed`, `added_to_cart`, `checkout_started`, `payment_failed`, `distance_blocked`, `order_completed`."
    },
    {
      "name": "Admin Analytics",
      "description": "Super Admin conversion funnel and abandoned-cart list. Auth: Admin JWT."
    }
  ],
  "paths": {
    "/consumer/analytics/events": {
      "post": {
        "summary": "Track funnel events (batch or single)",
        "description": "Ingest Customer App funnel events. Prefer batch `events[]`.\n\n`added_to_cart` / `checkout_started` also refresh the abandoned-cart timer for **logged-in** users.\n\nSee `docs/FLUTTER-ANALYTICS-ABANDONED-CART.md`.",
        "operationId": "trackConsumerAnalyticsEvents",
        "tags": ["Consumer Analytics"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "required": true,
            "schema": { "type": "string" },
            "description": "Bearer consumer JWT (or guest JWT)"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ConsumerAnalyticsEventsRequest" },
              "examples": {
                "batch": {
                  "summary": "Batch (preferred)",
                  "value": {
                    "events": [
                      {
                        "event_name": "app_opened",
                        "zone_id": 1,
                        "client_session": "uuid-optional",
                        "properties": { "lat": 32.08, "lng": 34.78 }
                      },
                      {
                        "event_name": "store_viewed",
                        "restaurant_id": 12
                      },
                      {
                        "event_name": "added_to_cart",
                        "restaurant_id": 12,
                        "properties": { "cart_total": 85.5 }
                      },
                      {
                        "event_name": "checkout_started",
                        "restaurant_id": 12
                      }
                    ]
                  }
                },
                "single": {
                  "summary": "Single event",
                  "value": {
                    "event_name": "payment_failed",
                    "properties": { "reason": "card_declined" }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Events recorded",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ConsumerAnalyticsEventsResponse" },
                "example": {
                  "status": true,
                  "msg": "Events recorded",
                  "data": { "recorded": 4 }
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiError" },
                "example": { "status": false, "msg": "\"event_name\" is required" }
              }
            }
          },
          "401": {
            "description": "Missing/invalid token",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiError" },
                "example": { "status": false, "msg": "Not authorized, no token" }
              }
            }
          }
        }
      }
    },
    "/admin/analytics/funnel": {
      "get": {
        "summary": "Conversion funnel (unique users per step)",
        "operationId": "adminAnalyticsFunnel",
        "tags": ["Admin Analytics"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "format": "date-time" }
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "format": "date-time" }
          }
        ],
        "responses": {
          "200": {
            "description": "Funnel steps",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AdminAnalyticsFunnelResponse" }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiError" }
              }
            }
          }
        }
      }
    },
    "/admin/analytics/events/summary": {
      "get": {
        "summary": "Event volume by name",
        "operationId": "adminAnalyticsEventsSummary",
        "tags": ["Admin Analytics"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "format": "date-time" }
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "format": "date-time" }
          }
        ],
        "responses": {
          "200": {
            "description": "Counts by event_name",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "boolean", "example": true },
                    "data": {
                      "type": "object",
                      "properties": {
                        "from": { "type": "string", "format": "date-time" },
                        "to": { "type": "string", "format": "date-time" },
                        "counts": {
                          "type": "object",
                          "additionalProperties": { "type": "integer" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/admin/analytics/abandoned-carts": {
      "get": {
        "summary": "List abandoned / recovery cart sessions",
        "operationId": "adminAbandonedCartsList",
        "tags": ["Admin Analytics"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["active", "abandoned", "recovered", "cancelled"]
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": { "type": "integer", "default": 1 }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": { "type": "integer", "default": 25 }
          },
          {
            "name": "from",
            "in": "query",
            "schema": { "type": "string", "format": "date-time" }
          },
          {
            "name": "to",
            "in": "query",
            "schema": { "type": "string", "format": "date-time" }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated sessions",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AdminAbandonedCartsResponse" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ConsumerAnalyticsEventName": {
        "type": "string",
        "enum": [
          "app_opened",
          "store_viewed",
          "product_viewed",
          "added_to_cart",
          "checkout_started",
          "payment_failed",
          "distance_blocked",
          "order_completed"
        ]
      },
      "ConsumerAnalyticsEventItem": {
        "type": "object",
        "required": ["event_name"],
        "properties": {
          "event_name": { "$ref": "#/components/schemas/ConsumerAnalyticsEventName" },
          "client_session": { "type": "string", "nullable": true, "maxLength": 128 },
          "restaurant_id": { "type": "number", "nullable": true },
          "zone_id": { "type": "number", "nullable": true },
          "properties": {
            "type": "object",
            "nullable": true,
            "additionalProperties": true,
            "description": "Free-form JSON (lat/lng, food_id, cart_total, error reason, …)"
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "Optional client timestamp (currently accepted; server uses ingest time)"
          }
        }
      },
      "ConsumerAnalyticsEventsRequest": {
        "type": "object",
        "description": "Send either `events` (batch) or top-level `event_name` (single).",
        "properties": {
          "events": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": { "$ref": "#/components/schemas/ConsumerAnalyticsEventItem" }
          },
          "event_name": { "$ref": "#/components/schemas/ConsumerAnalyticsEventName" },
          "client_session": { "type": "string", "nullable": true },
          "restaurant_id": { "type": "number", "nullable": true },
          "zone_id": { "type": "number", "nullable": true },
          "properties": { "type": "object", "nullable": true, "additionalProperties": true },
          "is_guest": { "type": "boolean" },
          "guest_id": { "type": "number", "nullable": true }
        }
      },
      "ConsumerAnalyticsEventsResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "boolean", "example": true },
          "msg": { "type": "string", "example": "Events recorded" },
          "data": {
            "type": "object",
            "properties": {
              "recorded": { "type": "integer", "example": 4 }
            }
          }
        }
      },
      "AdminAnalyticsFunnelResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "boolean", "example": true },
          "data": {
            "type": "object",
            "properties": {
              "from": { "type": "string", "format": "date-time" },
              "to": { "type": "string", "format": "date-time" },
              "funnel": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "step": { "type": "string" },
                    "label": { "type": "string" },
                    "users": { "type": "integer" },
                    "conversion_from_previous": { "type": "number", "nullable": true },
                    "conversion_from_open": { "type": "number", "nullable": true }
                  }
                }
              },
              "config": {
                "type": "object",
                "properties": {
                  "abandoned_cart_enabled": { "type": "boolean" },
                  "abandoned_cart_minutes": { "type": "integer" },
                  "whatsapp_recovery_enabled": { "type": "boolean" }
                }
              }
            }
          }
        }
      },
      "AdminAbandonedCartsResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "boolean" },
          "data": {
            "type": "object",
            "properties": {
              "page": { "type": "integer" },
              "limit": { "type": "integer" },
              "total": { "type": "integer" },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" },
                    "user_id": { "type": "string" },
                    "status": { "type": "string" },
                    "restaurant_name": { "type": "string", "nullable": true },
                    "customer_name": { "type": "string", "nullable": true },
                    "customer_phone": { "type": "string", "nullable": true },
                    "cart_total": { "type": "number" },
                    "whatsapp_status": { "type": "string" },
                    "deeplink": { "type": "string", "nullable": true },
                    "abandoned_at": { "type": "string", "nullable": true },
                    "last_activity_at": { "type": "string", "nullable": true }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

# Copy to `.env` on the server (and locally when using Docker Compose).
# Compose injects these into containers — editing .env + recreate backend is required.

# --- Docker Compose (backend container): use service name `postgres`, port 5432 ---
POSTGRES_PASSWORD=your_db_password_here
DATABASE_URL=postgresql://postgres:your_db_password_here@postgres:5432/gizra_db?schema=public

# --- Optional: run API on host with `npm run dev` against published Postgres port ---
# DATABASE_URL=postgresql://postgres:your_db_password_here@localhost:5434/gizra_db?schema=public

REDIS_URL=redis://redis:6379
JWT_SECRET=change_me
CLOUDFLARE_TUNNEL_TOKEN=
GEMINI_API_KEY=

# If P1000 after pull: volume password may differ from POSTGRES_PASSWORD in compose.
# Fix: set DATABASE_URL password to match existing DB, OR:
# docker exec gizra-postgres psql -U postgres -d gizra_db -c "ALTER USER postgres WITH PASSWORD 'your_db_password_here';"

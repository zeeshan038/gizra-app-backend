{
  "paths": {
    "/delivery-man/fcm-token": {
      "put": {
        "summary": "Update FCM device token",
        "description": "Store Firebase Cloud Messaging token for direct pushes (assigned order status). Subscribe to login `data.topic` separately for pool alerts.",
        "parameters": [{ "$ref": "#/components/parameters/DeliveryManAuthorizationHeader" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/FcmTokenUpdateBody" },
              "example": { "fcm_token": "dXyz_device_token_from_firebase" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token saved",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/FcmTokenUpdateResponse" },
                "example": {
                  "status": true,
                  "msg": "Successfully updated",
                  "message": "successfully updated!"
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ApiError400" },
          "401": { "$ref": "#/components/responses/ApiError401" },
          "500": { "$ref": "#/components/responses/ApiError500" }
        },
        "tags": ["Delivery Man Notifications"]
      }
    },
    "/delivery-man/notifications/toggle": {
      "put": {
        "summary": "Toggle push notifications (on/off)",
        "description": "Updates `is_notification_on` on the driver row. When **false**, direct FCM device pushes are skipped (inbox rows may still be stored). Send `{ \"enabled\": true|false }` to set explicitly; send `{}` or omit body to **flip** the current value.",
        "parameters": [{ "$ref": "#/components/parameters/DeliveryManAuthorizationHeader" }],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PushNotificationToggleBody" },
              "examples": {
                "setOn": { "summary": "Turn on", "value": { "enabled": true } },
                "setOff": { "summary": "Turn off", "value": { "enabled": false } },
                "flip": { "summary": "Flip current", "value": {} }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Preference updated",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PushNotificationToggleResponse" },
                "examples": {
                  "enabled": {
                    "value": {
                      "status": true,
                      "msg": "Push notifications enabled",
                      "data": { "is_notification_on": true }
                    }
                  },
                  "disabled": {
                    "value": {
                      "status": true,
                      "msg": "Push notifications disabled",
                      "data": { "is_notification_on": false }
                    }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ApiError400" },
          "401": { "$ref": "#/components/responses/ApiError401" },
          "404": { "$ref": "#/components/responses/ApiError404" },
          "500": { "$ref": "#/components/responses/ApiError500" }
        },
        "tags": ["Delivery Man Notifications"]
      }
    },
    "/delivery-man/notifications": {
      "get": {
        "summary": "Notification inbox (paginated)",
        "description": "Admin broadcasts (`tergat=deliveryman`) merged with `user_notifications` for this driver. Sorted newest first.",
        "parameters": [
          { "$ref": "#/components/parameters/DeliveryManAuthorizationHeader" },
          { "$ref": "#/components/parameters/NotificationInboxLimit" },
          { "$ref": "#/components/parameters/NotificationInboxOffset" },
          { "$ref": "#/components/parameters/NotificationInboxPage" },
          { "$ref": "#/components/parameters/NotificationInboxDaysDefault7" }
        ],
        "responses": {
          "200": {
            "description": "Paginated inbox",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/NotificationInboxListResponse" },
                "example": {
                  "status": true,
                  "msg": "Success",
                  "data": {
                    "total_size": 2,
                    "limit": 10,
                    "offset": 1,
                    "days": 7,
                    "notifications": [
                      {
                        "id": "501",
                        "data": "{\"title\":\"Order notification\",\"order_id\":\"100178\",\"type\":\"order_status\"}",
                        "status": true,
                        "delivery_man_id": 7,
                        "created_at": "2026-09-28T14:00:00.000Z",
                        "updated_at": "2026-09-28T14:00:00.000Z",
                        "source": "user_notification"
                      },
                      {
                        "id": "12",
                        "title": "Zone announcement",
                        "description": "Peak hours bonus active",
                        "image": "notification/banner.png",
                        "status": true,
                        "tergat": "deliveryman",
                        "zone_id": 2,
                        "created_at": "2026-09-27T10:00:00.000Z",
                        "updated_at": "2026-09-27T10:00:00.000Z",
                        "data": {
                          "title": "Zone announcement",
                          "description": "Peak hours bonus active",
                          "order_id": "",
                          "image": "notification/banner.png",
                          "type": "push_notification"
                        },
                        "image_full_url": "https://cdn.example.com/notification/banner.png",
                        "source": "broadcast"
                      }
                    ]
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/ApiError401" },
          "404": { "$ref": "#/components/responses/ApiError404" },
          "500": { "$ref": "#/components/responses/ApiError500" }
        },
        "tags": ["Delivery Man Notifications"]
      }
    },
    "/delivery-man/notifications/{id}": {
      "delete": {
        "summary": "Delete one inbox item",
        "description": "Removes a **user_notifications** row owned by this driver. Admin broadcast rows cannot be deleted.",
        "parameters": [
          { "$ref": "#/components/parameters/DeliveryManAuthorizationHeader" },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "pattern": "^[0-9]+$" },
            "description": "user_notifications.id"
          }
        ],
        "responses": {
          "200": {
            "description": "Removed",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/NotificationDeleteResponse" },
                "example": { "status": true, "msg": "Notification removed" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ApiError400" },
          "401": { "$ref": "#/components/responses/ApiError401" },
          "404": { "$ref": "#/components/responses/ApiError404" },
          "500": { "$ref": "#/components/responses/ApiError500" }
        },
        "tags": ["Delivery Man Notifications"]
      }
    },
    "/vendor/notifications": {
      "get": {
        "summary": "Notification inbox (paginated)",
        "description": "Admin broadcasts for restaurants in the vendor zone + order pushes in `user_notifications.vendor_id`.",
        "parameters": [
          { "$ref": "#/components/parameters/VendorAuthorizationHeader" },
          { "$ref": "#/components/parameters/NotificationInboxLimit" },
          { "$ref": "#/components/parameters/NotificationInboxOffset" },
          { "$ref": "#/components/parameters/NotificationInboxPage" },
          { "$ref": "#/components/parameters/NotificationInboxDaysDefault7" }
        ],
        "responses": {
          "200": {
            "description": "Paginated inbox",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/NotificationInboxListResponse" },
                "example": {
                  "status": true,
                  "msg": "Success",
                  "data": {
                    "total_size": 1,
                    "limit": 10,
                    "offset": 1,
                    "days": 7,
                    "notifications": [
                      {
                        "id": "880",
                        "data": "{\"title\":\"New order\",\"order_id\":\"100178\",\"type\":\"new_order\"}",
                        "status": true,
                        "vendor_id": 42,
                        "created_at": "2026-09-28T12:00:00.000Z",
                        "updated_at": "2026-09-28T12:00:00.000Z",
                        "source": "user_notification"
                      }
                    ]
                  }
                }
              }
            }
          },
          "403": { "$ref": "#/components/responses/ApiError403" },
          "500": { "$ref": "#/components/responses/ApiError500" }
        },
        "tags": ["Vendor Notifications"]
      }
    },
    "/vendor/notifications/toggle": {
      "put": {
        "summary": "Toggle push notifications (on/off)",
        "description": "Updates `is_notification_on` on the vendor row (POS mobile `firebase_token` and web `fcm_token_web`). When **false**, direct FCM pushes are skipped. Optional body `{ \"enabled\": boolean }`; empty body **flips** current value.",
        "parameters": [{ "$ref": "#/components/parameters/VendorAuthorizationHeader" }],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PushNotificationToggleBody" },
              "examples": {
                "setOn": { "value": { "enabled": true } },
                "setOff": { "value": { "enabled": false } },
                "flip": { "value": {} }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Preference updated",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PushNotificationToggleResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ApiError400" },
          "401": { "$ref": "#/components/responses/ApiError401" },
          "403": { "$ref": "#/components/responses/ApiError403" },
          "404": { "$ref": "#/components/responses/ApiError404" },
          "500": { "$ref": "#/components/responses/ApiError500" }
        },
        "tags": ["Vendor Notifications"]
      }
    },
    "/vendor/notifications/{id}": {
      "delete": {
        "summary": "Delete one inbox item",
        "parameters": [
          { "$ref": "#/components/parameters/VendorAuthorizationHeader" },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "pattern": "^[0-9]+$" }
          }
        ],
        "responses": {
          "200": {
            "description": "Removed",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/NotificationDeleteResponse" }
              }
            }
          },
          "403": { "$ref": "#/components/responses/ApiError403" },
          "404": { "$ref": "#/components/responses/ApiError404" },
          "500": { "$ref": "#/components/responses/ApiError500" }
        },
        "tags": ["Vendor Notifications"]
      }
    },
    "/consumer/notifications": {
      "get": {
        "summary": "Notification inbox (paginated)",
        "description": "Admin broadcasts for customer zones + order pushes. **Legacy:** send header `zoneId` as JSON array of zone ids; falls back to query `zone_id` or saved user zone. Default window **15 days** (broadcast filter uses `updated_at`).",
        "parameters": [
          { "$ref": "#/components/parameters/ConsumerAuthorizationHeader" },
          { "$ref": "#/components/parameters/ConsumerZoneIdHeader" },
          {
            "name": "zone_id",
            "in": "query",
            "schema": { "type": "integer" },
            "description": "Single zone id when zoneId header omitted"
          },
          { "$ref": "#/components/parameters/NotificationInboxLimit" },
          { "$ref": "#/components/parameters/NotificationInboxOffset" },
          { "$ref": "#/components/parameters/NotificationInboxPage" },
          { "$ref": "#/components/parameters/NotificationInboxDaysDefault15" }
        ],
        "responses": {
          "200": {
            "description": "Paginated inbox",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/NotificationInboxListResponse" },
                "example": {
                  "status": true,
                  "msg": "Success",
                  "data": {
                    "total_size": 1,
                    "limit": 10,
                    "offset": 1,
                    "days": 15,
                    "notifications": [
                      {
                        "id": "901",
                        "data": "{\"title\":\"Order notification\",\"order_id\":\"100178\",\"type\":\"order_status\",\"order_status\":\"processing\"}",
                        "status": true,
                        "user_id": 99,
                        "created_at": "2026-09-28T16:00:00.000Z",
                        "updated_at": "2026-09-28T16:00:00.000Z",
                        "source": "user_notification"
                      }
                    ]
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/ApiError401" },
          "500": { "$ref": "#/components/responses/ApiError500" }
        },
        "tags": ["Consumer Notifications"]
      }
    },
    "/consumer/notifications/toggle": {
      "put": {
        "summary": "Toggle push notifications (on/off)",
        "description": "Updates `is_notification_on` on the customer user row. When **false**, direct FCM pushes (`cm_firebase_token`) are skipped. Optional `{ \"enabled\": boolean }`; empty body **flips** current value. Read current state from **GET /consumer/whoami** → `data.is_notification_on`.",
        "parameters": [{ "$ref": "#/components/parameters/ConsumerAuthorizationHeader" }],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PushNotificationToggleBody" },
              "examples": {
                "setOn": { "value": { "enabled": true } },
                "setOff": { "value": { "enabled": false } },
                "flip": { "value": {} }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Preference updated",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PushNotificationToggleResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ApiError400" },
          "401": { "$ref": "#/components/responses/ApiError401" },
          "404": { "$ref": "#/components/responses/ApiError404" },
          "500": { "$ref": "#/components/responses/ApiError500" }
        },
        "tags": ["Consumer Notifications"]
      }
    },
    "/consumer/notifications/{id}": {
      "delete": {
        "summary": "Delete one inbox item",
        "parameters": [
          { "$ref": "#/components/parameters/ConsumerAuthorizationHeader" },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "pattern": "^[0-9]+$" }
          }
        ],
        "responses": {
          "200": {
            "description": "Removed",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/NotificationDeleteResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/ApiError401" },
          "404": { "$ref": "#/components/responses/ApiError404" },
          "500": { "$ref": "#/components/responses/ApiError500" }
        },
        "tags": ["Consumer Notifications"]
      }
    }
  },
  "components": {
    "parameters": {
      "NotificationInboxLimit": {
        "name": "limit",
        "in": "query",
        "schema": { "type": "integer", "minimum": 1, "maximum": 50, "default": 10 }
      },
      "NotificationInboxOffset": {
        "name": "offset",
        "in": "query",
        "description": "1-based page (legacy PHP name; same as `page`)",
        "schema": { "type": "integer", "minimum": 1, "default": 1 }
      },
      "NotificationInboxPage": {
        "name": "page",
        "in": "query",
        "schema": { "type": "integer", "minimum": 1 }
      },
      "NotificationInboxDaysDefault7": {
        "name": "days",
        "in": "query",
        "description": "Include rows from the last N days",
        "schema": { "type": "integer", "minimum": 1, "maximum": 90, "default": 7 }
      },
      "NotificationInboxDaysDefault15": {
        "name": "days",
        "in": "query",
        "schema": { "type": "integer", "minimum": 1, "maximum": 90, "default": 15 }
      },
      "ConsumerZoneIdHeader": {
        "name": "zoneId",
        "in": "header",
        "required": false,
        "schema": { "type": "string" },
        "description": "JSON array of zone ids, e.g. `[2]` or `[1,2]`",
        "example": "[2]"
      }
    },
    "schemas": {
      "PushNotificationToggleBody": {
        "type": "object",
        "description": "All properties optional. Omit `enabled` to flip the stored boolean.",
        "properties": {
          "enabled": {
            "type": "boolean",
            "description": "true = enable push, false = disable push"
          }
        },
        "additionalProperties": false
      },
      "PushNotificationToggleData": {
        "type": "object",
        "required": ["is_notification_on"],
        "properties": {
          "is_notification_on": {
            "type": "boolean",
            "description": "Master switch for FCM device pushes for this account"
          }
        }
      },
      "PushNotificationToggleResponse": {
        "type": "object",
        "required": ["status", "msg", "data"],
        "properties": {
          "status": { "type": "boolean", "example": true },
          "msg": {
            "type": "string",
            "example": "Push notifications enabled",
            "description": "Human-readable confirmation"
          },
          "data": { "$ref": "#/components/schemas/PushNotificationToggleData" }
        }
      },
      "FcmTokenUpdateBody": {
        "type": "object",
        "required": ["fcm_token"],
        "properties": {
          "fcm_token": { "type": "string", "minLength": 1 }
        }
      },
      "FcmTokenUpdateResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "boolean", "example": true },
          "msg": { "type": "string", "example": "Successfully updated" },
          "message": { "type": "string", "example": "successfully updated!" }
        }
      },
      "NotificationDeleteResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "boolean", "example": true },
          "msg": { "type": "string", "example": "Notification removed" }
        }
      },
      "NotificationInboxListResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "boolean", "example": true },
          "msg": { "type": "string", "example": "Success" },
          "data": { "$ref": "#/components/schemas/NotificationInboxPageData" }
        }
      },
      "NotificationInboxPageData": {
        "type": "object",
        "properties": {
          "total_size": { "type": "integer", "example": 25 },
          "limit": { "type": "integer", "example": 10 },
          "offset": { "type": "integer", "description": "Current 1-based page", "example": 1 },
          "days": { "type": "integer", "example": 7 },
          "notifications": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/NotificationInboxItem" }
          }
        }
      },
      "NotificationInboxItem": {
        "oneOf": [
          { "$ref": "#/components/schemas/NotificationInboxBroadcastItem" },
          { "$ref": "#/components/schemas/NotificationInboxUserItem" }
        ]
      },
      "NotificationInboxBroadcastItem": {
        "type": "object",
        "description": "Admin panel broadcast",
        "required": ["id", "source"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string", "nullable": true },
          "description": { "type": "string", "nullable": true },
          "image": { "type": "string", "nullable": true },
          "status": { "type": "boolean" },
          "tergat": { "type": "string", "example": "deliveryman" },
          "zone_id": { "type": "integer", "nullable": true },
          "created_at": { "type": "string", "format": "date-time", "nullable": true },
          "updated_at": { "type": "string", "format": "date-time", "nullable": true },
          "data": { "$ref": "#/components/schemas/NotificationBroadcastDataPayload" },
          "image_full_url": { "type": "string", "nullable": true },
          "source": { "type": "string", "enum": ["broadcast"] }
        }
      },
      "NotificationInboxUserItem": {
        "type": "object",
        "description": "Order/system push persisted for the app inbox",
        "required": ["id", "source"],
        "properties": {
          "id": { "type": "string" },
          "data": {
            "description": "JSON string (order push payload)",
            "oneOf": [{ "type": "string" }, { "type": "object" }]
          },
          "status": { "type": "boolean" },
          "user_id": { "type": "integer", "nullable": true },
          "vendor_id": { "type": "integer", "nullable": true },
          "delivery_man_id": { "type": "integer", "nullable": true },
          "created_at": { "type": "string", "format": "date-time", "nullable": true },
          "updated_at": { "type": "string", "format": "date-time", "nullable": true },
          "source": { "type": "string", "enum": ["user_notification"] }
        }
      },
      "NotificationBroadcastDataPayload": {
        "type": "object",
        "properties": {
          "title": { "type": "string", "nullable": true },
          "description": { "type": "string", "nullable": true },
          "order_id": { "type": "string", "example": "" },
          "image": { "type": "string", "nullable": true },
          "type": { "type": "string", "example": "push_notification" }
        }
      }
    },
    "responses": {
      "ApiError400": {
        "description": "Validation error",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ApiError" },
            "example": { "status": false, "msg": "FCM token is required" }
          }
        }
      },
      "ApiError401": {
        "description": "Unauthorized",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ApiError" },
            "example": { "status": false, "msg": "Unauthorized" }
          }
        }
      },
      "ApiError403": {
        "description": "Forbidden",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ApiError" },
            "example": { "status": false, "msg": "Restaurant context not found for vendor" }
          }
        }
      },
      "ApiError404": {
        "description": "Not found",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ApiError" },
            "example": { "status": false, "msg": "Notification not found" }
          }
        }
      },
      "ApiError500": {
        "description": "Server error",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ApiError" },
            "example": { "status": false, "msg": "Request failed" }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Delivery Man Notifications",
      "description": "GET /delivery-man/notifications, PUT /notifications/toggle, DELETE /notifications/{id}, PUT /fcm-token. Paginated inbox + push on/off + FCM device token."
    },
    {
      "name": "Vendor Notifications",
      "description": "GET /vendor/notifications, PUT /notifications/toggle, DELETE /notifications/{id}. New-order and admin broadcasts."
    },
    {
      "name": "Consumer Notifications",
      "description": "GET /consumer/notifications, PUT /notifications/toggle, DELETE /notifications/{id}. Use zoneId header or zone_id query."
    }
  ]
}

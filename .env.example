# Copy to `.env` on the server (and locally when using Docker Compose).

# Same on Mac and server (see env.example)
DATABASE_URL=postgresql://postgres:your_db_password_here@167.233.245.44:5434/gizra_db?schema=public

# One-time PHP → Postgres migration (Mac tunnels — see docs/MYSQL_TO_POSTGRES_MIGRATION.md)
# MYSQL_MIGRATION_URL=mysql://root:password@127.0.0.1:3307/gizra_db

REDIS_URL=redis://redis:6379
JWT_SECRET=change_me
GEMINI_API_KEY=

# Cloudflare R2 Storage (optional — not Cloudflare Tunnel)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ACCESS_KEY_ID=
CLOUDFLARE_SECRET_ACCESS_KEY=
CLOUDFLARE_BUCKET_NAME=
CLOUDFLARE_PUBLIC_URL=

# Firebase Cloud Messaging (service account JSON from Firebase Console → Project settings → Service accounts)
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# If P1000 / login fails: password in volume ≠ DATABASE_URL — run once on server:
#   npm run repair:prod-stack

# HyperPay (Israel) — digital checkout after POST /consumer/order/place + generate-payment-link
API_PUBLIC_URL=https://backend-prod.gizra.app
HYP_BASE_URL=https://pay.hyp.co.il/p/
HYP_MASOF=
HYP_PASSP=
HYP_API_KEY=

# Mail — copy from PHP Admin → Mail Config (or Laravel deliverymain .env)
APP_NAME=Gizra
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Gizra
# Dev: set OTP_EMAIL_SEND=true to actually SMTP-send when NODE_ENV is not production
# OTP_EMAIL_SEND=true

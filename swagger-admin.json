    "/upload/": {
      "post": {
        "tags": [
          "Upload"
        ],
        "description": "Upload a file (image or video) to Cloudflare R2",
        "parameters": [
          {
            "name": "file",
            "in": "formData",
            "required": true,
            "description": "The file to upload",
            "schema": {
              "type": "file"
            }
          },
          {
            "name": "subfolder",
            "in": "formData",
            "required": false,
            "description": "Optional subfolder path e.g. vendors/abc/assets",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "File uploaded successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "boolean",
                      "example": true
                    },
                    "msg": {
                      "type": "string",
                      "example": "File uploaded successfully"
                    },
                    "url": {
                      "type": "string",
                      "example": "https://pub-xxxx.r2.dev/assets/abc-123.png"
                    }
                  },
                  "xml": {
                    "name": "main"
                  }
                }
              },
              "application/xml": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "boolean",
                      "example": true

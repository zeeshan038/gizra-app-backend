# --- Server (Docker Compose on Hetzner) ---
# DATABASE_URL host must be `postgres` (not 127.0.0.1 or the server public IP).
DATABASE_URL=postgresql://postgres:your_db_password_here@postgres:5432/gizra_db?schema=public
REDIS_URL=redis://redis:6379

# --- Mac local dev (Postgres via compose port 5434) ---
# DATABASE_URL=postgresql://postgres:your_db_password_here@127.0.0.1:5434/gizra_db?schema=public
# REDIS_URL=redis://127.0.0.1:6380

JWT_SECRET=change_me
CLOUDFLARE_TUNNEL_TOKEN=
GEMINI_API_KEY=

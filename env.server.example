# Copy to `.env` on the Hetzner server (~/gizra-app-backend).
# Set DATABASE_URL once — same idea as your other backends. Postgres still runs in this compose stack.

PORT=3000
DATABASE_URL=postgresql://postgres:mysecretpassword@postgres:5432/gizra_db?schema=public
REDIS_URL=redis://redis:6379
JWT_SECRET=change_me_to_a_long_random_string

CLOUDFLARE_TUNNEL_TOKEN=
GEMINI_API_KEY=

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ACCESS_KEY_ID=
CLOUDFLARE_SECRET_ACCESS_KEY=
CLOUDFLARE_BUCKET_NAME=
CLOUDFLARE_PUBLIC_URL=

# Optional: only used when creating a NEW postgres volume (first install). Must match password in DATABASE_URL.
# POSTGRES_PASSWORD=mysecretpassword

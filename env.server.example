# =============================================================================
# Gizra production server — ~/gizra-app-backend/.env
# =============================================================================
#
# PERMANENT MODEL (do not fight this):
#   • ONE password lives in DATABASE_URL below (same password on your Mac .env for :5434).
#   • Prod API container NEVER uses that host — it uses postgres:5432 + Docker pg_hba trust.
#   • Mac dev uses @167.233.245.44:5434 with the password in the URL.
#   • Never copy the whole Mac .env here (REDIS_URL here must be redis://redis:6379).
#
# ONE-TIME (or after any DB/auth mess) — on the server:
#   cd ~/gizra-app-backend
#   unset DATABASE_URL POSTGRES_PASSWORD
#   git pull origin zeeshan-dev
#   npm run fix:prod-db
#   curl -s https://backend-prod.gizra.app/api/health/db   # must be "db":"ok"
#
# EVERY CODE DEPLOY (only command you need day-to-day):
#   cd ~/gizra-app-backend
#   unset DATABASE_URL POSTGRES_PASSWORD
#   git pull origin zeeshan-dev
#   npm run deploy:server
#
# MONITOR (bookmark):
#   https://backend-prod.gizra.app/api/health/db
#
# OPTIONAL — auto-heal on server (users never SSH; cron fixes DB before long outages):
#   sudo touch /var/log/gizra-auto-heal.log && sudo chown $(whoami) /var/log/gizra-auto-heal.log
#   crontab -e
#   */5 * * * * cd ~/gizra-app-backend && npm run prod:auto-heal >/dev/null 2>&1
#
# NEVER on the server:
#   • docker compose up … without npm run deploy:server / npm run compose
#   • export DATABASE_URL=… or POSTGRES_PASSWORD=… in ~/.bashrc (causes 20–30 min drift)
#   • sed/deleting DATABASE_URL from .env
#   • routine npm run fix:prod-db when https://backend-prod.gizra.app/api/health/db is ok
#   • cron that runs fix:prod-db in a loop (use prod:auto-heal only, or disable cron)
#
# WHY IT BREAKS EVERY 20–30 MIN (usual causes):
#   1. Shell has export DATABASE_URL or POSTGRES_PASSWORD → overrides .env on compose up
#   2. Auto-heal cron ran full repair (single-user) too often → postgres NOLOGIN blips
#   3. Mac .env password ≠ server .env password → you “fix” DB while API uses another
#   4. Reboot without: unset … && npm run deploy:server
#
# CHECK ON SERVER:
#   crontab -l | grep gizra          # remove aggressive repair crons if unsure
#   grep DATABASE_URL ~/.bashrc      # should be empty
#
# FRESH DOCKER (WIPES ALL DB DATA — backup first):
#   cd ~/gizra-app-backend
#   # Pick ONE password; put it in DATABASE_URL below and on your Mac .env
#   unset DATABASE_URL POSTGRES_PASSWORD
#   GIZRA_CONFIRM_WIPE=1 ./scripts/reset-prod-docker.sh
#
# MAC / DATAGRIP / TABLEPLUS (no password surprises):
#   Terminal 1: ssh -N -L 5434:127.0.0.1:5434 root@167.233.245.44
#   Connect: Host 127.0.0.1  Port 5434  User postgres  Password = same as server .env
#   DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5434/gizra_db?schema=public
#   (Do NOT use 167.x on Mac without tunnel — use 127.0.0.1 through the tunnel.)
#
# =============================================================================

PORT=3000
DATABASE_URL=postgresql://postgres:mysecretpassword@167.233.245.44:5434/gizra_db?schema=public
REDIS_URL=redis://redis:6379
JWT_SECRET=change_me_to_a_long_random_string

# Public HTTPS: nginx (or Caddy) on this VPS → proxy_pass http://127.0.0.1:3002
# (backend container maps 3002:3000). DNS backend-prod.gizra.app → server IP.
# Do NOT use Cloudflare Tunnel in Docker — not part of this stack.

GEMINI_API_KEY=

# Optional — Cloudflare R2 media storage (not tunnel):
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ACCESS_KEY_ID=
CLOUDFLARE_SECRET_ACCESS_KEY=
CLOUDFLARE_BUCKET_NAME=
CLOUDFLARE_PUBLIC_URL=

{
  "tags": [
    {
      "name": "Consumer Coupons",
      "description": "**Private admin-issued codes** — customers type a code at checkout (video/SMS). Coupon **codes are not listed** in the app.\n\n**Base URL:** `https://backend-dev.gizra.app/api` (paths below are relative to `/api`). Full reference: `docs/CONSUMER-COUPON-API.md`.\n\n| Step | Method | Path | Body |\n|------|--------|------|------|\n| Preview | `GET` | `/consumer/coupon/apply?code=&restaurant_id=&order_amount=` | — |\n| Place order | `POST` | `/consumer/order/place` | `coupon_code` in JSON (see `ConsumerPlaceOrderRequest`) |\n\n**List routes** (`/coupon/list`, `/coupon/restaurant-wise`, `/restaurants/coupons`) always return `{ \"status\": true, \"data\": [] }`.\n\n**Auth:** `apply` + `list` = registered customer JWT. **One use per customer** (default) → HTTP **406** if reused.\n\nErrors: `{ \"status\": false, \"msg\": \"...\" }`."
    }
  ],
  "paths": {
    "/consumer/coupon/apply": {
      "get": {
        "summary": "Validate typed coupon at checkout (preview)",
        "description": "Customer enters a code they received **outside the app**. Validates dates, eligibility, restaurant/zone rules, min purchase (when `order_amount` sent), and **per-user usage** (default once).\n\nDoes **not** return the `code` in the response. Re-validate on place-order with the same string in `coupon_code`.",
        "tags": ["Consumer Coupons"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/ConsumerAuthorizationHeader" },
          {
            "name": "code",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "example": "SUMMER20" },
            "description": "Promo code the customer typed"
          },
          {
            "name": "restaurant_id",
            "in": "query",
            "required": true,
            "schema": { "type": "integer", "example": 3 }
          },
          {
            "name": "order_amount",
            "in": "query",
            "required": false,
            "schema": { "type": "number", "example": 150.5 },
            "description": "Food subtotal before coupon (enforces min_purchase and fills coupon_discount_amount)"
          }
        ],
        "responses": {
          "200": {
            "description": "Valid for this user and restaurant",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ConsumerCouponApplyResponse" },
                "example": {
                  "status": true,
                  "data": {
                    "id": 12,
                    "title": "10% off",
                    "discount": 10,
                    "discount_type": "percent",
                    "min_purchase": 50,
                    "max_discount": 25,
                    "coupon_type": "default",
                    "coupon_discount_amount": 15.05,
                    "enter_code_at_checkout": true
                  }
                }
              }
            }
          },
          "403": {
            "description": "Not eligible or minimum purchase not met",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiError" },
                "examples": {
                  "notEligible": {
                    "value": { "status": false, "msg": "You are not eligible for this coupon" }
                  },
                  "minPurchase": {
                    "value": { "status": false, "msg": "Minimum purchase not met for coupon" }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Unknown code or not valid for restaurant",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiError" },
                "example": { "status": false, "msg": "Coupon not found" }
              }
            }
          },
          "406": {
            "description": "Already used on this account or usage limit",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiError" },
                "example": {
                  "status": false,
                  "msg": "This coupon has already been used on your account"
                }
              }
            }
          },
          "407": {
            "description": "Expired or not started",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiError" },
                "example": { "status": false, "msg": "Coupon expired" }
              }
            }
          }
        }
      }
    },
    "/consumer/coupon/list": {
      "get": {
        "summary": "Customer coupon list (deprecated — always empty)",
        "description": "Legacy route kept for app compatibility. **Does not expose admin codes.** Always returns `data: []`. Use typed code + `/coupon/apply` + place-order instead.",
        "tags": ["Consumer Coupons"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/ConsumerZoneIdQuery" },
          { "$ref": "#/components/parameters/ConsumerAuthorizationHeader" },
          {
            "name": "restaurant_id",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "example": 3 }
          }
        ],
        "responses": {
          "200": {
            "description": "Empty list",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ConsumerCouponListResponse" },
                "example": {
                  "status": true,
                  "data": [],
                  "msg": "Coupons are applied at checkout with a code you received separately"
                }
              }
            }
          },
          "401": {
            "description": "Guest or invalid JWT",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiError" },
                "example": { "status": false, "msg": "Login required" }
              }
            }
          },
          "403": {
            "description": "Missing zone_id",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiError" },
                "example": { "status": false, "msg": "Zone id is required" }
              }
            }
          }
        }
      }
    },
    "/consumer/coupon/restaurant-wise": {
      "get": {
        "summary": "Restaurant public coupons (deprecated — always empty)",
        "description": "Legacy route. **No JWT.** Always `data: []` — codes are not shown on restaurant screens.",
        "tags": ["Consumer Coupons"],
        "parameters": [
          { "$ref": "#/components/parameters/ConsumerZoneIdQuery" },
          {
            "name": "restaurant_id",
            "in": "query",
            "required": true,
            "schema": { "type": "integer", "example": 3 }
          }
        ],
        "responses": {
          "200": {
            "description": "Empty list",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ConsumerCouponListResponse" },
                "example": {
                  "status": true,
                  "data": [],
                  "msg": "Coupons are applied at checkout with a code you received separately"
                }
              }
            }
          },
          "403": {
            "description": "Missing zone_id or invalid restaurant_id",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiError" }
              }
            }
          }
        }
      }
    },
    "/consumer/restaurants/coupons": {
      "get": {
        "summary": "Restaurant detail coupons (deprecated — always empty)",
        "description": "Legacy `GET /api/v1/restaurants/get-coupon`. Always `data: []`. Optional `customer_id` for logged-in context; codes are never returned.",
        "tags": ["Consumer Coupons"],
        "parameters": [
          {
            "name": "restaurant_id",
            "in": "query",
            "required": true,
            "schema": { "type": "integer", "example": 3 }
          },
          {
            "name": "customer_id",
            "in": "query",
            "required": false,
            "schema": { "type": "integer" },
            "description": "Legacy optional filter"
          }
        ],
        "responses": {
          "200": {
            "description": "Empty list",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ConsumerCouponListResponse" },
                "example": {
                  "status": true,
                  "data": [],
                  "msg": "Coupons are applied at checkout with a code you received separately"
                }
              }
            }
          },
          "403": {
            "description": "restaurant_id required",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiError" },
                "example": { "status": false, "msg": "restaurant_id is required" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ConsumerCouponListResponse": {
        "type": "object",
        "required": ["status", "data"],
        "properties": {
          "status": { "type": "boolean", "example": true },
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ConsumerCouponPreview" },
            "description": "Always empty array in current product"
          },
          "msg": {
            "type": "string",
            "nullable": true,
            "example": "Coupons are applied at checkout with a code you received separately"
          }
        }
      },
      "ConsumerCouponApplyResponse": {
        "type": "object",
        "required": ["status", "data"],
        "properties": {
          "status": { "type": "boolean", "example": true },
          "data": { "$ref": "#/components/schemas/ConsumerCouponPreview" }
        }
      },
      "ConsumerCouponPreview": {
        "type": "object",
        "description": "Checkout preview — **no `code` field**. Customer must remember the code they typed.",
        "properties": {
          "id": { "type": "integer", "example": 12 },
          "title": { "type": "string", "nullable": true, "example": "10% off" },
          "start_date": { "type": "string", "format": "date-time", "nullable": true },
          "expire_date": { "type": "string", "format": "date-time", "nullable": true },
          "min_purchase": { "type": "number", "example": 50 },
          "max_discount": { "type": "number", "example": 25 },
          "discount": { "type": "number", "example": 10 },
          "discount_type": { "type": "string", "enum": ["percent", "percentage", "amount", ""], "example": "percent" },
          "coupon_type": {
            "type": "string",
            "description": "default | restaurant_wise | zone_wise | first_order | free_delivery",
            "example": "default"
          },
          "status": { "type": "boolean" },
          "data": {
            "nullable": true,
            "description": "Restaurant name label for restaurant_wise coupons"
          },
          "restaurant_id": { "type": "integer", "nullable": true },
          "restaurant": {
            "type": "object",
            "nullable": true,
            "properties": {
              "id": { "type": "integer" },
              "name": { "type": "string" }
            }
          },
          "coupon_discount_amount": {
            "type": "number",
            "nullable": true,
            "description": "Computed discount when order_amount was sent on apply",
            "example": 15.05
          },
          "enter_code_at_checkout": {
            "type": "boolean",
            "example": true,
            "description": "Always true — UI should use manual entry"
          }
        }
      },
      "ConsumerCouponItem": {
        "description": "Deprecated alias — use ConsumerCouponPreview (no code).",
        "allOf": [{ "$ref": "#/components/schemas/ConsumerCouponPreview" }]
      },
      "ConsumerPlaceOrderCouponSnippet": {
        "type": "object",
        "description": "Subset of POST /consumer/order/place used for coupons. Full body: ConsumerPlaceOrderRequest in Consumer Order tag.",
        "properties": {
          "restaurant_id": { "type": "integer", "example": 3 },
          "coupon_code": {
            "type": "string",
            "description": "Same string the customer typed; validated again server-side",
            "example": "SUMMER20"
          }
        },
        "required": ["restaurant_id", "coupon_code"]
      }
    }
  }
}